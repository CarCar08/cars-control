<ui:FluentWindow
    x:Class="CarsControl.App.Views.FrameTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CarsControl.App.ViewModels"
    Title="Test it on this PC"
    Width="640"
    Height="520"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="C.A.R.S. Control" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,12">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Intro}" TextWrapping="Wrap" />

                <!--  Pick the game  -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:FrameTestStep.Pick}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Game" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox AutomationProperties.Name="Game to test" ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" ToolTip="Programs with a window; games C.A.R.S. recognizes are listed first. Start the game first if it isn't here." />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RefreshProgramsCommand}" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="List running programs again (after starting the game)" />
                    </Grid>
                    <TextBlock Margin="0,0,0,6" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding PickHint}" TextWrapping="Wrap" Visibility="{Binding PickHint, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                        Text="Recording uses Intel PresentMon (free, open source), downloaded once from its official release and checked before use. Windows only lets administrators read frame times, so it runs in the admin helper." />
                </StackPanel>

                <!--  Recording  -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:FrameTestStep.Recording}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
                    <ProgressBar Height="6" Margin="0,10,0,0" Maximum="100" Value="{Binding Progress}" />
                </StackPanel>

                <!--  Waiting for a restart  -->
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Status}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:FrameTestStep.NeedsRestart}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  Result  -->
                <TextBlock FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding ResultText}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:FrameTestStep.Result}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Error}" TextWrapping="Wrap" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <!--  Pick  -->
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding RecordCommand}" Content="{Binding RecordButton}" ToolTip="Gets admin approval if needed, counts down 10 seconds so you can switch to the game, then records 60 seconds.">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:FrameTestStep.Pick}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <!--  Recording  -->
                <ui:Button Margin="0,0,8,0" Command="{Binding StopCommand}" Content="Stop" ToolTip="Stops waiting; nothing is changed by stopping.">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:FrameTestStep.Recording}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <!--  Result  -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Step}" Value="{x:Static vm:FrameTestStep.Result}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ui:Button Margin="0,0,8,0" Command="{Binding UndoCommand}" Content="{Binding UndoText}" ToolTip="Puts the setting back to how it was before the test." />
                    <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding KeepCommand}" Content="{Binding KeepText}" ToolTip="Leaves the change in place." />
                </StackPanel>
                <ui:Button Command="{Binding CloseCommand}" Content="Close" ToolTip="Closes this window. A test waiting for a restart can be continued from the Optimization page." />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
