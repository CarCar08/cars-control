<Page
    x:Class="CarsControl.App.Views.StoragePage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:stab="clr-namespace:CarsControl.App.Views.StorageTabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Storage"
    PreviewKeyDown="OnPreviewKeyDown"
    PreviewMouseDown="OnPreviewMouseDown"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <Style x:Key="Caption" BasedOn="{StaticResource Subtle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="62" />
        </Style>
    </Page.Resources>
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="Storage" />
            <TextBlock Style="{StaticResource Subtle}" Text="What's using your drives, your games, big forgotten files, and the old Windows install" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,8,0,0">
            <!--  ===== Explore =====  -->
            <TabItem Header="Explore">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" MaxHeight="260" />
                    </Grid.RowDefinitions>

                    <!--  drive cards: the active one is outlined  -->
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Frame" Margin="0,0,8,0" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8">
                                    <ui:CardAction
                                        Padding="14,10"
                                        AutomationProperties.Name="{Binding Letter, StringFormat='Drive {0}'}"
                                        Command="{Binding Data.ScanCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding Letter}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Letter}" />
                                                <TextBlock Margin="8,4,0,0" Style="{StaticResource Subtle}" Text="{Binding Label}" />
                                            </StackPanel>
                                            <ProgressBar x:Name="Bar" Height="4" Margin="0,6,0,4" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Value="{Binding UsedPercent, Mode=OneWay}" />
                                            <Grid>
                                                <TextBlock x:Name="Free" FontSize="12" Text="{Binding FreeText}" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="11" Style="{StaticResource Subtle}" Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </StackPanel>
                                    </ui:CardAction>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                        <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter TargetName="Free" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                        <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  status: exactly one of progress / summary is visible at a time  -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,4">
                        <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ScanStatus}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Height="4" Margin="0,6,0,0" IsIndeterminate="{Binding ScanIndeterminate}" Maximum="100" Value="{Binding ScanPercent, Mode=OneWay}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding CancelScanCommand}" Content="Cancel" ToolTip="Stop scanning. What was scanned so far is kept." />
                        </Grid>
                        <TextBlock Style="{StaticResource Subtle}" Text="{Binding ScanSummary}" TextWrapping="Wrap" Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding ScanNotice}" TextWrapping="Wrap" Visibility="{Binding ScanNotice, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!--  navigation: back / forward / up (mouse side buttons and Alt+arrows too), breadcrumb, filter  -->
                    <Grid Grid.Row="2" Margin="0,4,0,8" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Margin="0,0,4,0" Padding="8,4" AutomationProperties.Name="Back" Command="{Binding BackCommand}" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Back (mouse back button, Alt+Left)" />
                            <ui:Button Margin="0,0,4,0" Padding="8,4" AutomationProperties.Name="Forward" Command="{Binding ForwardCommand}" Icon="{ui:SymbolIcon ArrowRight24}" ToolTip="Forward (mouse forward button, Alt+Right)" />
                            <ui:Button Margin="0,0,8,0" Padding="8,4" AutomationProperties.Name="Up one level" Command="{Binding UpCommand}" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Up one level (Alt+Up)" />
                            <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Breadcrumb}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button
                                                Padding="6,2"
                                                Appearance="Transparent"
                                                Command="{Binding Data.NavigateCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}" ToolTip="Navigate to this folder in the storage view." />
                                            <TextBlock Margin="2,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="›" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:TextBox
                                Width="200"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="Filter folders"
                                ClearButtonEnabled="True"
                                Icon="{ui:SymbolIcon Filter24}"
                                PlaceholderText="Filter this folder"
                                Text="{Binding FolderFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="Show matching folder names in this view without changing any files." />
                            <ui:Button Margin="0,0,8,0" Command="{Binding ExploreCurrentCommand}" Content="Open in Explorer" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open this folder in Explorer." />
                            <ui:Button Command="{Binding RescanCommand}" Content="Rescan" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Scan this drive again (results are otherwise reused from the last scan)." />
                        </StackPanel>
                    </Grid>

                    <!--  empty state  -->
                    <ui:Card Grid.Row="3" Grid.RowSpan="2" Padding="24" VerticalAlignment="Top" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Pick a drive to see what's using it" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Subtle}" Text="With WizTree installed, scans read the drive's file table directly (Fast scan): seconds even on A:, and it can see system folders. That needs the admin helper — one prompt per session. Results are saved, so next time they show instantly." TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <controls:TreemapControl x:Name="Map" Grid.Row="3" MinHeight="160" Node="{Binding Current}" />

                    <DataGrid
                        x:Name="FolderGrid"
                        Grid.Row="4"
                        Margin="0,10,0,0"
                        controls:GridSort.Descending="{Binding FolderSortDescending}"
                        controls:GridSort.Key="{Binding FolderSortKey}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Folders}"
                        MouseDoubleClick="OnFolderDoubleClick"
                        PreviewMouseRightButtonDown="OnGridRightButtonDown"
                        RowHeight="32"
                        SelectionMode="Single"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Data.OpenFolderRowCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Open" />
                                <MenuItem Command="{Binding Data.ExploreCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.SelectedItem.Node.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Show in Explorer" ToolTip="Look inside this folder in Explorer before deciding." />
                                <MenuItem Command="{Binding Data.CopyTextCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.SelectedItem.Node.FullPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Copy path" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="3*" Header="Folder (double-click to open)" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Node.FullPath, Converter={StaticResource EmptyToNull}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="2*" controls:GridSort.DescendingFirst="True" Header="Share" SortMemberPath="Percent">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Height="6" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="100" controls:GridSort.DescendingFirst="True" Binding="{Binding SizeText}" Header="Size" SortMemberPath="Bytes" />
                            <DataGridTextColumn Width="130" controls:GridSort.DescendingFirst="True" Binding="{Binding FilesText}" Header="Files" SortMemberPath="Files" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!--  ===== Big & old files =====  -->
            <TabItem Header="Big &amp; old files">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  drives (several at once) + search  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="Drives" />
                            <ItemsControl ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding FileDriveChips}" />
                        </DockPanel>
                        <ui:TextBox
                            Grid.Column="1"
                            Width="300"
                            Margin="12,0,0,6"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Search files"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Search file or folder name"
                            Text="{Binding FileSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"  ToolTip="Filter the displayed file results by name or path. No files are changed."/>
                    </Grid>

                    <!--  type chips (one at a time, with counts); folds away with the Filters toggle  -->
                    <DockPanel Grid.Row="1" Visibility="{Binding ShowFileFilters, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="Type" />
                        <ItemsControl ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding FileKindChips}" />
                    </DockPanel>

                    <!--  filters (fold away with the Filters toggle)  -->
                    <Grid Grid.Row="2" Margin="0,2,0,0" Visibility="{Binding ShowFileFilters, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Show" />
                            <ComboBox MinWidth="190" Margin="0,0,8,6" AutomationProperties.Name="Untouched for" ItemsSource="{Binding FileAgeOptions}" SelectedItem="{Binding FileAge}" ToolTip="Only files that haven't changed for at least this long: old forgotten files are the usual space wasters." />
                            <ComboBox MinWidth="210" Margin="0,0,8,6" AutomationProperties.Name="Owner" ItemsSource="{Binding FileOwnerOptions}" SelectedItem="{Binding FileOwner}" ToolTip="Only files that belong to something (an app, a game, Windows) or to nothing in particular. Files nothing owns are the safest to remove." />
                            <ComboBox MinWidth="120" Margin="0,0,8,6" AutomationProperties.Name="Minimum size" ItemsSource="{Binding FileSizeOptions}" SelectedItem="{Binding FileMinSize}" ToolTip="Hide files smaller than this." />
                            <ui:Button Margin="0,0,0,6" Appearance="Transparent" Command="{Binding ResetFileFiltersCommand}" Content="Reset filters" Icon="{ui:SymbolIcon Dismiss24}" Visibility="{Binding HasFileFilters, Converter={StaticResource BoolToVisibility}}" ToolTip="Clear every filter." />
                        </WrapPanel>
                    </Grid>

                    <!--  summary, scan progress, last action; the Filters toggle and Sort stay visible here  -->
                    <Grid Grid.Row="3" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                            <ToggleButton Margin="0,0,10,0" Padding="10,5" AutomationProperties.Name="Show filters" IsChecked="{Binding ShowFileFilters}" ToolTip="Show or hide the type chips and filters">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Filter24" />
                                    <TextBlock Text="{Binding FiltersButtonText}" />
                                </StackPanel>
                            </ToggleButton>
                            <ComboBox MinWidth="170" AutomationProperties.Name="Sort files by" ItemsSource="{Binding FileSortOptions}" SelectedItem="{Binding SelectedFileSort}" ToolTip="Change the order of the list." />
                            <ui:Button Margin="6,0,0,0" Padding="9,7" AutomationProperties.Name="Reverse file order" Command="{Binding ToggleFileSortDirectionCommand}" ToolTip="Reverse the order">
                                <ui:SymbolIcon Symbol="{Binding FileSortDescending, Converter={StaticResource SortSymbol}}" />
                            </ui:Button>
                        </StackPanel>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,6" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ScanStatus}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Height="4" Margin="0,4,0,0" IsIndeterminate="{Binding ScanIndeterminate}" Maximum="100" Value="{Binding ScanPercent, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" Text="{Binding FilesSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding FilesNotice}" TextWrapping="Wrap" Visibility="{Binding FilesNotice, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    </Grid>

                    <DataGrid
                        x:Name="FileGrid"
                        Grid.Row="4"
                        controls:GridSort.Descending="{Binding FileSortDescending}"
                        controls:GridSort.Key="{Binding FileSortKey}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Files}"
                        MouseDoubleClick="OnFileDoubleClick"
                        PreviewMouseRightButtonDown="OnGridRightButtonDown"
                        RowHeight="36"
                        SelectionChanged="OnFileSelectionChanged"
                        SelectionMode="Extended"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ShowSelectedCommand}" Header="Show in Explorer" ToolTip="Show the selected file in Explorer." />
                                <MenuItem Command="{Binding CopySelectedPathCommand}" Header="Copy path" />
                                <Separator />
                                <MenuItem Command="{Binding FreeUpSelectedCommand}" Header="Free up space (keep in the cloud)" />
                                <MenuItem Command="{Binding RecycleSelectedCommand}" Header="Send to the Recycle Bin…" ToolTip="Send the ticked files to the Recycle Bin (you see the list and total first). Files an app, game or Windows needs can't be ticked." />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="2*" Header="File" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding File.Path, Converter={StaticResource EmptyToNull}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="58" Binding="{Binding Drive}" Header="Drive" SortMemberPath="Drive" />
                            <DataGridTextColumn Width="84" controls:GridSort.DescendingFirst="True" Binding="{Binding SizeText}" Header="Size" SortMemberPath="Bytes" />
                            <DataGridTemplateColumn Width="104" controls:GridSort.DescendingFirst="True" Header="Untouched" SortMemberPath="AgeDays">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding AgeText}" ToolTip="{Binding AgeTip, Converter={StaticResource EmptyToNull}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="2*" Header="Belongs to" SortMemberPath="OwnerText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Owner" VerticalAlignment="Center" FontSize="12" Text="{Binding OwnerText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OwnerText, Converter={StaticResource EmptyToNull}}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                <Setter TargetName="Owner" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="2*" Header="Folder" SortMemberPath="Folder">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder, Converter={StaticResource EmptyToNull}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button Margin="0,0,6,0" Padding="8,3" Command="{Binding Data.ExploreCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding File.Path}" Content="Show" ToolTip="Show the selected item and its location without deleting it." />
                                            <ui:Button
                                                MinWidth="70"
                                                Padding="8,3"
                                                Command="{Binding Data.FileActionCommand, Source={StaticResource Proxy}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding ActionText}"
                                                IsEnabled="{Binding CanAct}"
                                                ToolTip="{Binding ActionTip, Converter={StaticResource EmptyToNull}}"
                                                ToolTipService.ShowOnDisabled="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  bulk actions for the selected rows (Ctrl/Shift-click to pick several)  -->
                    <Border
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        Padding="14,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Visibility="{Binding HasFileSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{Binding FileSelectionSummary}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0" Command="{Binding ShowSelectedCommand}" Content="Show" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Show the selected item and its location without deleting it." />
                                <ui:Button Margin="0,0,8,0" Command="{Binding FreeUpSelectedCommand}" Content="Free up space" Icon="{ui:SymbolIcon CloudArrowDown24}" ToolTip="Make cloud files online-only: they stay in iCloud / Proton Drive, the copy on this disk goes" />
                                <ui:Button Appearance="Danger" Command="{Binding RecycleSelectedCommand}" Content="Recycle selected" Icon="{ui:SymbolIcon Delete24}" ToolTip="Review the selected files, then send them to the Recycle Bin so they can be restored." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Duplicates">
                <stab:DuplicatesTab />
            </TabItem>
            <TabItem Header="Junk">
                <stab:JunkTab />
            </TabItem>

            <!--  ===== Games =====  -->
            <TabItem Header="Games">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="From" />
                                <ItemsControl ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding GameSourceChips}" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="Libraries" />
                                <ItemsControl ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding GameLibraryChips}" />
                            </DockPanel>
                        </StackPanel>
                        <ui:TextBox
                            Grid.Column="1"
                            Width="260"
                            Margin="12,0,0,6"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Search games"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Search games"
                            Text="{Binding GameSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}"  ToolTip="Filter the game list by name; installed games and launcher records are unchanged."/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="Show" />
                            <ComboBox MinWidth="210" Margin="0,0,8,6" AutomationProperties.Name="Last played" ItemsSource="{Binding GamePlayedOptions}" SelectedItem="{Binding GamePlayed}" ToolTip="Only games you haven't played for at least this long: candidates to uninstall or move to a bigger drive." />
                            <ui:Button Margin="0,0,0,6" Appearance="Transparent" Command="{Binding ResetGameFiltersCommand}" Content="Reset filters" Icon="{ui:SymbolIcon Dismiss24}" Visibility="{Binding HasGameFilters, Converter={StaticResource BoolToVisibility}}" ToolTip="Clear every filter." />
                            <ui:ProgressRing Width="16" Height="16" Margin="8,0,0,6" IsIndeterminate="True" Visibility="{Binding IsLoadingReports, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,6" VerticalAlignment="Top" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="Sort" />
                            <ComboBox MinWidth="170" AutomationProperties.Name="Sort games by" ItemsSource="{Binding GameSortOptions}" SelectedItem="{Binding SelectedGameSort}" ToolTip="Change the order of the games." />
                            <ui:Button Margin="6,0,0,0" Padding="9,7" AutomationProperties.Name="Reverse game order" Command="{Binding ToggleGameSortDirectionCommand}" ToolTip="Reverse the order">
                                <ui:SymbolIcon Symbol="{Binding GameSortDescending, Converter={StaticResource SortSymbol}}" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="0,4,0,8" Style="{StaticResource Subtle}" Text="{Binding GamesSummary}" />

                    <DataGrid
                        x:Name="GameGrid"
                        Grid.Row="3"
                        controls:GridSort.Descending="{Binding GameSortDescending}"
                        controls:GridSort.Key="{Binding GameSortKey}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Games}"
                        PreviewMouseRightButtonDown="OnGridRightButtonDown"
                        RowHeight="36"
                        SelectionMode="Single"
                        VirtualizingPanel.ScrollUnit="Pixel">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding Data.ExploreCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.SelectedItem.Game.InstallPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Open game folder" />
                                <MenuItem Command="{Binding Data.CopyTextCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.SelectedItem.Game.InstallPath, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Copy path" />
                                <Separator />
                                <MenuItem Command="{Binding Data.MoveGameCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Move to another library…" />
                                <MenuItem Command="{Binding Data.UninstallGameCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Uninstall…" ToolTip="Uninstall through its launcher (Steam or Epic), then offer to clean what it leaves behind." />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="3*" Binding="{Binding Name}" Header="Game" SortMemberPath="Name" />
                            <DataGridTextColumn Width="70" Binding="{Binding Source}" Header="From" SortMemberPath="Source" />
                            <DataGridTextColumn Width="58" Binding="{Binding Drive}" Header="Drive" SortMemberPath="Drive" />
                            <DataGridTextColumn Width="90" controls:GridSort.DescendingFirst="True" Binding="{Binding SizeText}" Header="Size" SortMemberPath="Bytes" />
                            <DataGridTextColumn Width="190" controls:GridSort.DescendingFirst="True" Binding="{Binding PlayedText}" Header="Last played" SortMemberPath="DaysSincePlayed" />
                            <DataGridTextColumn Width="80" controls:GridSort.DescendingFirst="True" Binding="{Binding HoursText}" Header="Played" SortMemberPath="Minutes" />
                            <DataGridTemplateColumn Width="2*" Header="Library" SortMemberPath="Library">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Game.Library}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Game.InstallPath, Converter={StaticResource EmptyToNull}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button Margin="0,0,6,0" Padding="8,3" Command="{Binding Data.ExploreCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding Game.InstallPath}" Content="Folder" ToolTip="Open this item in its folder in File Explorer." />
                                            <ui:Button Margin="0,0,6,0" Padding="8,3" AutomationProperties.Name="{Binding Name, StringFormat='Move {0} to another library'}" Command="{Binding Data.MoveGameCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Move…" IsEnabled="{Binding CanMove}" ToolTip="Move a Steam game to another Steam library, or an Epic game to another drive. Shows the plan before changing anything." />
                                            <ui:Button Margin="0,0,6,0" Padding="8,3" Command="{Binding Data.RemoveMovedCopyCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="{Binding MovedCopyButton}" ToolTip="{Binding MovedCopyTip}" Visibility="{Binding HasMovedCopy, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button Padding="8,3" Command="{Binding Data.UninstallGameCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Uninstall…" ToolTip="Review the removal plan for this app before anything is uninstalled." />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Move folders">
                <stab:MoveFoldersTab />
            </TabItem>

            <!--  ===== Old Windows =====  -->
            <TabItem Header="{Binding OldWindowsTab}">
                <ScrollViewer Margin="0,12,0,0" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding OldWindowsSummary}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,12" Style="{StaticResource Subtle}" Text="Removing one needs admin approval, and C.A.R.S. shows exactly what goes first. It refuses anything an installed program still points into, and never touches game libraries or other folders on the same drive. Take anything personal out of Users first. Largest first." TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding OldWindowsParts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Card Margin="0,0,0,6" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Path}" />
                                                <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Advice}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Bytes, Converter={StaticResource BytesText}}" />
                                                <ui:Button Margin="0,0,6,0" Command="{Binding Data.ExploreCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding Path}" Content="Open" ToolTip="Open the selected folder in File Explorer." />
                                                <ui:Button Appearance="Danger" AutomationProperties.Name="{Binding Path, StringFormat='Remove {0}'}" Command="{Binding Data.RemoveOldWindowsPartCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Remove…" Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove this folder of the old Windows for good (admin approval; it shows exactly what goes first)." />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
