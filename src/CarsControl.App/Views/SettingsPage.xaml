<Page
    x:Class="CarsControl.App.Views.SettingsPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:CarsControl.App.Services"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings">
    <Page.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Page.Resources>
    <!--  Two panes, like Windows Settings: the section list on the left, one section on the right
          (one long page stopped scaling once it had a dozen sections).  -->
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource Subtle}" Text="{Binding Version}" />
            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,10,0,0" IsClosable="True" IsOpen="{Binding Message, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Message}" Severity="Success" Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ListBox
            x:Name="SectionList"
            Grid.Row="1"
            Margin="0,0,16,0"
            AutomationProperties.Name="Settings sections"
            Background="Transparent"
            BorderThickness="0"
            SelectionChanged="OnSectionChanged">
                <!--  Selected like the sidebar (subtle fill and a short accent bar), not a solid accent block.  -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Fill" Background="Transparent" CornerRadius="4" />
                                        <Border x:Name="Bar" Width="3" Height="16" HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="2" Visibility="Collapsed" />
                                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem AutomationProperties.Name="Appearance" Tag="Appearance">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="DarkTheme24" />
                        <TextBlock VerticalAlignment="Center" Text="Appearance" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Scheduled maintenance" Tag="Maintenance">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="CalendarSync24" />
                        <TextBlock VerticalAlignment="Center" Text="Scheduled maintenance" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Gaming mode" Tag="Gaming">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="Games24" />
                        <TextBlock VerticalAlignment="Center" Text="Gaming mode" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Phone alerts" Tag="Alerts">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="Send24" />
                        <TextBlock VerticalAlignment="Center" Text="Phone alerts" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Health" Tag="Health">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="HeartPulse24" />
                        <TextBlock VerticalAlignment="Center" Text="Health" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Command palette" Tag="Palette">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="Search24" />
                        <TextBlock VerticalAlignment="Center" Text="Command palette" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Background work" Tag="Background">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="AppsListDetail24" />
                        <TextBlock VerticalAlignment="Center" Text="Background work" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Admin helper" Tag="Helper">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="Shield24" />
                        <TextBlock VerticalAlignment="Center" Text="Admin helper" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="This PC" Tag="ThisPc">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="Settings24" />
                        <TextBlock VerticalAlignment="Center" Text="This PC" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Protected apps" Tag="Protected">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="ShieldLock24" />
                        <TextBlock VerticalAlignment="Center" Text="Protected apps" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Ignored updates" Tag="Ignored">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="ArrowSync24" />
                        <TextBlock VerticalAlignment="Center" Text="Ignored updates" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="About and updates" Tag="Updates">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="Info24" />
                        <TextBlock VerticalAlignment="Center" Text="About &amp; updates" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="Data and files" Tag="Data">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" FontSize="16" Symbol="Document24" />
                        <TextBlock VerticalAlignment="Center" Text="Data and files" />
                    </StackPanel>
                </ListBoxItem>
        </ListBox>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Grid.Column="1" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,16" MaxWidth="1100" HorizontalAlignment="Left">
            <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitle}" Text="Appearance" />
                <ui:CardControl Margin="0,0,0,4" Header="Theme" Icon="{ui:SymbolIcon DarkTheme24}">
                    <ComboBox MinWidth="240" AutomationProperties.Name="Theme" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"  ToolTip="Choose dark, light or the Windows theme; changes only how C.A.R.S. looks."/>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Image24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="Background" />
                            <TextBlock FontSize="12" Style="{StaticResource Subtle}" TextTrimming="None" TextWrapping="Wrap"
                                Text="Translucent lets your wallpaper tint the window (Windows 11's Mica). Windows only draws it while C.A.R.S. is the window you're using; when you click elsewhere it turns solid until you come back. It also needs Windows' Transparency effects (Settings › Personalization › Colors) to be on." />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox MinWidth="240" AutomationProperties.Name="Background" ItemsSource="{Binding BackdropOptions}" SelectedItem="{Binding Backdrop}"  ToolTip="Choose a solid background or wallpaper-tinted Mica. Windows uses a solid fallback while the window is inactive."/>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,16" Header="Accent color" Icon="{ui:SymbolIcon Color24}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0" Orientation="Horizontal" Visibility="{Binding IsCustomAccent, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="22" Height="22" Margin="0,0,8,0" Background="{Binding CustomAccent, Converter={StaticResource HexBrush}}" CornerRadius="4" />
                            <ui:TextBox Width="110" AutomationProperties.Name="Custom accent color" PlaceholderText="#18A08C" Text="{Binding CustomAccent, UpdateSourceTrigger=PropertyChanged, Delay=300}"  ToolTip="Enter a six-digit color such as #18A08C for buttons and highlights."/>
                        </StackPanel>
                        <ComboBox MinWidth="240" AutomationProperties.Name="Accent color" ItemsSource="{Binding AccentOptions}" SelectedItem="{Binding Accent}"  ToolTip="Use C.A.R.S. teal, the Windows accent, or your own color for buttons and highlights."/>
                    </StackPanel>
                </ui:CardControl>
            </StackPanel>

            <StackPanel x:Name="PanelMaintenance" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Scheduled maintenance" /><ctl:HelpButton Topic="settings-maintenance" /></StackPanel>
                <ui:Card Margin="0,0,0,16" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Run updates and cleanup on a schedule" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Runs as you while you're away. Admin parts (Windows Update, apps for all users, system cleanup) use an admin session that's already open, or wait for one approval when you're back: no prompt ever waits on an empty screen. Never during a game; a run the PC missed catches up once." TextWrapping="Wrap" />
                            </StackPanel>
 <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal"><ctl:RecommendedBadge Item="MaintenanceEnabled" /><ui:ToggleSwitch AutomationProperties.Name="Scheduled maintenance" VerticalAlignment="Center" IsChecked="{Binding MaintenanceEnabled}"  ToolTip="Enable the schedule below. Runs only when you are away; administrator work uses an approved session or waits for your approval."/></StackPanel>
                        </Grid>
                        <StackPanel Margin="0,12,0,0" IsEnabled="{Binding MaintenanceEnabled}">
                            <TextBlock Margin="0,0,0,4" Style="{StaticResource Subtle}" Text="Days" />
                            <ItemsControl AutomationProperties.Name="Maintenance days" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding MaintenanceDays}" />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="At" />
                                <ComboBox Width="110" Margin="0,0,16,6" AutomationProperties.Name="Maintenance time" ItemsSource="{Binding MaintenanceTimes}" SelectedItem="{Binding MaintenanceTime}"  ToolTip="Choose when maintenance is due on the selected days. Missed runs wait until you are idle."/>
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="once you've been away for" />
                                <ui:NumberBox Width="140" Margin="0,0,8,6" AutomationProperties.Name="Idle minutes before maintenance" ClearButtonEnabled="False" Maximum="120" Minimum="0" SmallChange="1" Value="{Binding MaintenanceIdleMinutes}"  ToolTip="Minimum time without keyboard or mouse input before scheduled maintenance may start."/>
                                <TextBlock VerticalAlignment="Center" Text="minutes (no keyboard or mouse input, nothing full screen)" />
                            </WrapPanel>

 <DockPanel Margin="0,14,0,6" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="MaintenanceUpdates" /><CheckBox Content="Install updates from" IsChecked="{Binding MaintenanceUpdates}"  ToolTip="Include default-selected updates from the chosen sources in scheduled maintenance; held and ignored versions remain excluded."/></DockPanel>
                            <ItemsControl AutomationProperties.Name="Maintenance update sources" IsEnabled="{Binding MaintenanceUpdates}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding MaintenanceSources}" />
                            <TextBlock Style="{StaticResource Subtle}" Text="Only updates that are ticked by default: held drivers and ignored updates are left alone. Apps that are open are skipped, never closed." TextWrapping="Wrap" />

 <DockPanel Margin="0,14,0,6" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="MaintenanceCleanupOn" /><CheckBox Content="Clean up" IsChecked="{Binding MaintenanceCleanupOn}"  ToolTip="Include the selected cleanup categories in scheduled maintenance. Keep categories you may need excluded."/></DockPanel>
                            <ItemsControl AutomationProperties.Name="Maintenance cleanup categories" IsEnabled="{Binding MaintenanceCleanupOn}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding MaintenanceCleanup}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding MaintenanceStatus}" TextWrapping="Wrap" />
                                <ui:Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding RunMaintenanceNowCommand}" Content="Run now" Icon="{ui:SymbolIcon Play24}" ToolTip="Runs it now with you here: one admin prompt if admin items are included" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelGaming" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Gaming mode" /><ctl:HelpButton Topic="settings-gaming" /></StackPanel>
                <ui:Card Margin="0,0,0,16" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding GamingStatus}" TextWrapping="Wrap" />
                                <StackPanel Margin="0,4,0,4" Orientation="Horizontal" Visibility="{Binding GamingDetectedProgram, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding GamingDetectedProgram, StringFormat='Turned on by {0}.'}" />
                                    <ui:Button Margin="8,0,0,0" Padding="8,2" Command="{Binding NotAGameCommand}" Content="Not a game" ToolTip="Never let this program turn Gaming mode on" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Subtle}" Text="{x:Static svc:Extras.GamingIntro}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="Gaming mode on or off" Command="{Binding ToggleGamingCommand}" IsChecked="{Binding IsGaming, Mode=OneWay}" ToolTip="{x:Static svc:Extras.GamingToggleTip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Games24" />
                                    <TextBlock Text="Gaming mode" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Turn on automatically when a game starts" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Games from Steam, Epic and your other installed games. Off again 30 seconds after the last one closes." TextWrapping="Wrap" />
                            </StackPanel>
 <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal"><ctl:RecommendedBadge Item="GamingAutomatic" /><ui:ToggleSwitch AutomationProperties.Name="Automatic Gaming mode" VerticalAlignment="Center" IsChecked="{Binding GamingAutomatic}"  ToolTip="{x:Static svc:Extras.GamingAutomaticTip}"/></StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,4" Style="{StaticResource Subtle}" Text="While Gaming mode is on (these need admin):" />
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="GamingPauseWindowsUpdate" /><CheckBox Content="Pause Windows Update (resumed afterwards; a pause you set yourself is left alone)" IsChecked="{Binding GamingPauseWindowsUpdate}"  ToolTip="While Gaming mode is on (these need admin):"/></DockPanel>
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="GamingPauseSearch" /><CheckBox Content="Pause Windows Search indexing (resumed afterwards)" IsChecked="{Binding GamingPauseSearch}"  ToolTip="While Gaming mode is on (these need admin):"/></DockPanel>
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="GamingFreeStandby" /><CheckBox Content="Free standby memory when a game starts (like ISLC)" IsChecked="{Binding GamingFreeStandby}"  ToolTip="While Gaming mode is on (these need admin):"/></DockPanel>
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource Subtle}" Text="Afterwards:" />
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="GamingMaintenanceAfter" /><CheckBox Content="Run maintenance that came due during the game, once you've been idle" IsChecked="{Binding GamingMaintenanceAfter}"  ToolTip="While Gaming mode is on (these need admin):"/></DockPanel>

                        <Border Margin="0,12,0,0" Padding="12,10" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Ask for admin once at sign-in" />
                                        <TextBlock Style="{StaticResource Subtle}" Text="So no prompt ever appears mid-game. The admin session then stays open while you're signed in." TextWrapping="Wrap" />
                                    </StackPanel>
 <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal"><ctl:RecommendedBadge Item="GamingApproveAtSignIn" /><ui:ToggleSwitch AutomationProperties.Name="Ask for admin once at sign-in" VerticalAlignment="Center" IsChecked="{Binding GamingApproveAtSignIn}"  ToolTip="Ask once after sign-in so Gaming mode can use that approved session later; no prompt appears during a game."/></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding GamingSessionStatus}" TextWrapping="Wrap" />
                                    <ui:Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding ApproveGamingSessionCommand}" Content="Approve now" Icon="{ui:SymbolIcon Shield24}" Visibility="{Binding GamingSessionActive, Converter={StaticResource InverseBoolToVisibility}}"  ToolTip="Open the administrator session explicitly now; Windows asks for approval once."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Subtle}" Text="Also count as games (one program per line, e.g. game.exe)" TextWrapping="Wrap" />
                                <TextBox Height="70" Margin="0,4,0,0" AcceptsReturn="True" AutomationProperties.Name="Extra games" FontFamily="Cascadia Mono, Consolas" Text="{Binding GamingExtraGames, UpdateSourceTrigger=PropertyChanged, Delay=600}" VerticalScrollBarVisibility="Auto"  ToolTip="Add executable names, one per line, for games the library scan does not recognize."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Subtle}" Text="Never count as games (tools inside a game folder)" TextWrapping="Wrap" />
                                <TextBox Height="70" Margin="0,4,0,0" AcceptsReturn="True" AutomationProperties.Name="Programs that are not games" FontFamily="Cascadia Mono, Consolas" Text="{Binding GamingIgnored, UpdateSourceTrigger=PropertyChanged, Delay=600}" VerticalScrollBarVisibility="Auto"  ToolTip="Add executable names that should never trigger automatic Gaming mode."/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Subtle}" Text="{Binding GamingLastSession}" TextWrapping="Wrap" Visibility="{Binding GamingLastSession, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelAlerts" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Phone alerts" /><ctl:HelpButton Topic="settings-alerts" /></StackPanel>
                <ui:Card Margin="0,0,0,16" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Send alerts to your phone with ntfy" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Short messages with counts, drive letters and times only: never file or app names, paths or error text. Install the free ntfy app on your phone and subscribe to the topic below." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Margin="12,0,0,0" AutomationProperties.Name="Phone alerts" IsChecked="{Binding AlertsEnabled}"  ToolTip="Enable phone notifications using the ntfy server and topic below. Review the message types and quiet hours first."/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  QR: the topic as text (scan with the camera, copy, paste into ntfy's "Subscribe to topic")  -->
                            <Border Width="132" Height="132" Margin="0,0,16,0" Padding="6" VerticalAlignment="Top" Background="White" CornerRadius="6" Visibility="{Binding AlertQr, Converter={StaticResource NullToCollapsed}}">
                                <Image AutomationProperties.Name="Topic QR code" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding AlertQr}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Subtle}" Text="Topic (the only key to your alerts, so keep it to yourself)" />
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                    <TextBox MinWidth="280" AutomationProperties.Name="Alert topic" FontFamily="Cascadia Mono, Consolas" IsReadOnly="True" Text="{Binding AlertTopic, TargetNullValue='(made when you switch alerts on)'}"  ToolTip="The subscription address for your phone alerts. Keep this random topic private; anyone who knows it may be able to read or post messages."/>
                                    <ui:Button Margin="8,0,0,0" Command="{Binding CopyAlertTopicCommand}" Content="Copy" Icon="{ui:SymbolIcon Copy24}"  ToolTip="Copy the current ntfy topic to your clipboard so you can subscribe from your phone."/>
                                    <ui:Button Margin="8,0,0,0" Command="{Binding NewAlertTopicCommand}" Content="New topic" ToolTip="Makes a new random topic: phones subscribed to the old one stop getting alerts" />
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Subtle}" Text="On iPhone: scan the code with the Camera, tap the text to copy it, then in ntfy tap + and paste it as the topic." TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,16,6">
                                        <TextBlock Style="{StaticResource Subtle}" Text="Server" />
                                        <TextBox Width="220" Margin="0,4,0,0" AutomationProperties.Name="ntfy server" Text="{Binding AlertServer, UpdateSourceTrigger=PropertyChanged, Delay=600}"  ToolTip="Use the default ntfy service or your own HTTPS server. C.A.R.S. sends only the enabled alert types."/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,6">
                                        <TextBlock Style="{StaticResource Subtle}" Text="Name for this PC in alerts (optional)" />
                                        <TextBox Width="200" Margin="0,4,0,0" AutomationProperties.Name="Name for this PC in alerts" Text="{Binding AlertDeviceLabel, UpdateSourceTrigger=PropertyChanged, Delay=600}"  ToolTip="A short label to recognize this PC in phone notifications; it is sent with your alerts."/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Style="{StaticResource Subtle}" Text="Access token (only for a server that needs one; stored encrypted)" />
                                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                            <TextBox Width="200" AutomationProperties.Name="Access token" Text="{Binding AlertTokenInput, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding AlertHasToken, Converter={StaticResource InverseBoolToVisibility}}"  ToolTip="Optional ntfy access token. Save stores it encrypted for this Windows account; setup sync never exports it."/>
                                            <ui:Button Margin="8,0,0,0" Command="{Binding SaveAlertTokenCommand}" Content="Save" Visibility="{Binding AlertHasToken, Converter={StaticResource InverseBoolToVisibility}}"  ToolTip="Store the entered ntfy token encrypted for this Windows account. It is never exported in setup sync."/>
                                            <TextBlock VerticalAlignment="Center" Text="Token saved (encrypted)" Visibility="{Binding AlertHasToken, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button Margin="8,0,0,0" Command="{Binding RemoveAlertTokenCommand}" Content="Remove" Visibility="{Binding AlertHasToken, Converter={StaticResource BoolToVisibility}}"  ToolTip="Access token (only for a server that needs one; stored encrypted)"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,14,0,4" Style="{StaticResource Subtle}" Text="Tell me about" />
                        <CheckBox Margin="0,2" Content="Scheduled maintenance results" IsChecked="{Binding AlertMaintenance}"  ToolTip="GB free (and under 10% of the drive)"/>
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="AlertFailures" /><CheckBox Content="Failures (updates or cleanup that failed while you were away)" IsChecked="{Binding AlertFailures}"  ToolTip="GB free (and under 10% of the drive)"/></DockPanel>
                        <CheckBox Margin="0,2" Content="Admin items waiting for your approval" IsChecked="{Binding AlertApproval}"  ToolTip="GB free (and under 10% of the drive)"/>
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="AlertCrashes" /><CheckBox Content="Blue screens and unexpected shutdowns" IsChecked="{Binding AlertCrashes}"  ToolTip="GB free (and under 10% of the drive)"/></DockPanel>
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="AlertDriveHealth" /><CheckBox Content="Drive health problems (always sent, even in quiet hours)" IsChecked="{Binding AlertDriveHealth}"  ToolTip="GB free (and under 10% of the drive)"/></DockPanel>
                        <CheckBox Margin="0,2" Content="The processor or graphics card running hot (limits are in the Health section)" IsChecked="{Binding AlertTemperature}"  ToolTip="GB free (and under 10% of the drive)"/>
                        <StackPanel Margin="0,2" Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" Content="Low disk space: under" IsChecked="{Binding AlertLowDisk}"  ToolTip="GB free (and under 10% of the drive)"/>
                            <ui:NumberBox Width="150" Margin="8,0" AutomationProperties.Name="Low disk space threshold in GB" ClearButtonEnabled="False" Maximum="1000" Minimum="1" SmallChange="5" Value="{Binding AlertLowDiskGb}"  ToolTip="Send a low-space warning when free space falls below this many gigabytes."/>
                            <TextBlock VerticalAlignment="Center" Text="GB free (and under 10% of the drive)" />
                        </StackPanel>
                        <StackPanel Margin="0,2" Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" Content="A drive filling fast: more than" IsChecked="{Binding AlertFillingFast}"  ToolTip="GB free (and under 10% of the drive)"/>
                            <ui:NumberBox Width="150" Margin="8,0" AutomationProperties.Name="Filling fast threshold in GB" ClearButtonEnabled="False" Maximum="1000" Minimum="1" SmallChange="5" Value="{Binding AlertFillingFastGb}"  ToolTip="Warn when a drive loses more than this much free space over the configured observation period."/>
                            <TextBlock VerticalAlignment="Center" Text="GB used up in a day" />
                        </StackPanel>
                        <CheckBox Margin="0,2" Content="A weekly reminder when updates have been waiting for a week" IsChecked="{Binding AlertDigest}"  ToolTip="GB free (and under 10% of the drive)"/>

                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox Margin="0,0,10,6" VerticalAlignment="Center" Content="Quiet hours from" IsChecked="{Binding AlertQuiet}"  ToolTip="(held and sent when they end; drive health and a nearly full drive still come through)"/>
                            <ComboBox Width="100" Margin="0,0,8,6" AutomationProperties.Name="Quiet hours start" ItemsSource="{Binding MaintenanceTimes}" SelectedItem="{Binding AlertQuietFrom}"  ToolTip="Hold noncritical phone notifications from this hour until the end of quiet hours."/>
                            <TextBlock Margin="0,0,8,6" VerticalAlignment="Center" Text="to" />
                            <ComboBox Width="100" Margin="0,0,10,6" AutomationProperties.Name="Quiet hours end" ItemsSource="{Binding MaintenanceTimes}" SelectedItem="{Binding AlertQuietTo}"  ToolTip="Release held noncritical phone notifications at this hour; critical drive-health warnings are not held."/>
                            <TextBlock Margin="0,0,0,6" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="(held and sent when they end; drive health and a nearly full drive still come through)" TextWrapping="Wrap" />
                        </WrapPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding AlertStatus}" TextWrapping="Wrap" />
                            <ui:Button Grid.Column="1" Margin="12,0,0,0" Command="{Binding SendTestAlertCommand}" Content="Send test" Icon="{ui:SymbolIcon Send24}"  ToolTip="Send a real test notification to the configured ntfy topic, even if alerts are disabled."/>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelHealth" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Health" /><ctl:HelpButton Topic="health-restore-points" /></StackPanel>
                <ui:Card Margin="0,0,0,16" Padding="16,12">
                    <StackPanel>
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="HealthTempAlerts" /><CheckBox Content="Alert me (phone and notification) when the processor or graphics card stays too hot" IsChecked="{Binding HealthTempAlerts}"  ToolTip="It has to stay above the limit for several readings in a row, and you hear about it at most once every six hours."/></DockPanel>
                        <StackPanel Margin="28,6,0,0" IsEnabled="{Binding HealthTempAlerts}" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Processor above" />
                            <ui:NumberBox Width="120" Margin="8,0" AutomationProperties.Name="Processor temperature limit in degrees" ClearButtonEnabled="False" Maximum="110" Minimum="60" SmallChange="1" Value="{Binding HealthCpuLimit}"  ToolTip="Warn only after repeated processor readings at or above this temperature in degrees Celsius."/>
                            <TextBlock Margin="0,0,24,0" VerticalAlignment="Center" Text="°C" />
                            <TextBlock VerticalAlignment="Center" Text="Graphics card above" />
                            <ui:NumberBox Width="120" Margin="8,0" AutomationProperties.Name="Graphics card temperature limit in degrees" ClearButtonEnabled="False" Maximum="110" Minimum="60" SmallChange="1" Value="{Binding HealthGpuLimit}"  ToolTip="Warn only after repeated graphics-card readings at or above this temperature in degrees Celsius."/>
                            <TextBlock VerticalAlignment="Center" Text="°C" />
                        </StackPanel>
                        <TextBlock Margin="28,4,0,0" FontSize="12" Style="{StaticResource Subtle}" Text="It has to stay above the limit for several readings in a row, and you hear about it at most once every six hours." TextTrimming="None" TextWrapping="Wrap" />
 <DockPanel Margin="0,14,0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="HealthBoardSensors" /><CheckBox Content="Read the processor and motherboard sensors on the Sensors tab (needs the PawnIO driver and one admin approval)" IsChecked="{Binding HealthBoardSensors}"  ToolTip="It has to stay above the limit for several readings in a row, and you hear about it at most once every six hours."/></DockPanel>
 <DockPanel Margin="0,2" LastChildFill="True"><ctl:RecommendedBadge DockPanel.Dock="Right" Item="HealthRestorePoints" /><CheckBox Content="Make a restore point before removing old drivers, driver and feature updates, and privacy batches (when System Protection is on)" IsChecked="{Binding HealthRestorePoints}"  ToolTip="It has to stay above the limit for several readings in a row, and you hear about it at most once every six hours."/></DockPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelPalette" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Command palette" /><ctl:HelpButton Topic="settings-palette" /></StackPanel>
                <ui:Card Margin="0,0,0,16" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Press Ctrl+K anywhere in C.A.R.S. to search everything" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Actions, pages, apps, games, big files and settings. Enter runs the top result, → shows more actions (update, uninstall, open folder…). What you use most moves up." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding OpenPaletteCommand}" Content="Open it" Icon="{ui:SymbolIcon Search24}"  ToolTip="Press Ctrl+K anywhere in C.A.R.S. to search everything"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Shortcut that works from any app" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Click the box and press the keys you want (Ctrl, Alt or Win plus a key)." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" Margin="12,0,0,0" AutomationProperties.Name="Global shortcut for the command palette" IsChecked="{Binding PaletteGlobal}"  ToolTip="Register the shortcut below so the command palette can open while another application is active."/>
                        </Grid>
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal" IsEnabled="{Binding PaletteGlobal}">
                            <TextBox
                                x:Name="HotkeyBox"
                                Width="220"
                                AutomationProperties.Name="Palette shortcut"
                                FontFamily="Cascadia Mono, Consolas"
                                IsReadOnly="True"
                                IsReadOnlyCaretVisible="False"
                                PreviewKeyDown="OnHotkeyKeyDown"
                                Text="{Binding PaletteHotkey, Mode=OneWay}"
                                ToolTip="Click here, then press the shortcut" />
                            <ui:Button Margin="8,0,0,0" Click="OnHotkeyReset" Content="Reset to Ctrl+Alt+Space"  ToolTip="Restore the default global shortcut for opening the command palette."/>
                        </StackPanel>
                        <TextBlock x:Name="PaletteStatusText" Margin="0,6,0,0" Text="{Binding PaletteStatus}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource Subtle}" TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PaletteProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ui:Button Margin="0,10,0,0" Appearance="Transparent" Command="{Binding ResetPaletteUsageCommand}" Content="Forget what I use most"  ToolTip="Clear command-palette usage rankings. Commands and settings are kept."/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelBackground" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Background work" /><ctl:HelpButton Topic="settings-background" /></StackPanel>
                <ui:CardControl Margin="0,0,0,4" Header="Keep running in the tray and check for updates" Icon="{ui:SymbolIcon AppsListDetail24}">
 <StackPanel Orientation="Horizontal"><ctl:RecommendedBadge Item="RunInBackground" /><ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding RunInBackground}"  ToolTip="Keep C.A.R.S. in the tray when its window closes, so enabled maintenance, monitoring and alerts can continue." AutomationProperties.Name="Keep running in the tray" /></StackPanel>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,4" Header="Check every (hours)" Icon="{ui:SymbolIcon Clock24}">
                    <ui:NumberBox Width="140" ClearButtonEnabled="False" Maximum="48" Minimum="1" SmallChange="1" Value="{Binding CheckIntervalHours}"  ToolTip="How often enabled background update checks become due. Checks are postponed during games."/>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,16" Header="Start with Windows (minimised to the tray)" Icon="{ui:SymbolIcon Power24}">
 <StackPanel Orientation="Horizontal"><ctl:RecommendedBadge Item="StartWithWindows" /><ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}"  ToolTip="Start the application quietly in the tray after sign-in so enabled background features can work." AutomationProperties.Name="Start with Windows" /></StackPanel>
                </ui:CardControl>
            </StackPanel>

            <StackPanel x:Name="PanelHelper" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Admin helper" /><ctl:HelpButton Topic="settings-admin-helper" /></StackPanel>
                <ui:Card Margin="0,0,0,4" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Admin work runs in one helper per session: Windows asks for an administrator's PIN or password once, and the helper closes when you exit or after it has been idle for:" TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:NumberBox Width="140" ClearButtonEnabled="False" Maximum="240" Minimum="1" SmallChange="5" Value="{Binding HelperIdleMinutes}"  ToolTip="Close an approved administrator session after this many idle minutes; the application itself stays unelevated."/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="minutes" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button Command="{Binding TestHelperCommand}" Content="Test admin helper" Icon="{ui:SymbolIcon Shield24}"  ToolTip="Admin work runs in one helper per session: Windows asks for an administrator&apos;s PIN or password once, and the helper closes when you exit or after it has been idle for:"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding HelperStatus}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelThisPc" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="This PC" /><ctl:HelpButton Topic="settings-holds" /></StackPanel>
                <ui:Card Margin="0,0,0,4" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="What kind of PC is this?" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Decides which settings get a Recommended tag across the app: a laptop sleeps at night and runs on battery, a gaming PC puts games first." TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="230" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="What kind of PC is this" ItemsSource="{Binding PcTypeOptions}" SelectedItem="{Binding PcTypeChoice}"  ToolTip="Choose the profile that controls recommendation badges. Changing this does not apply recommended settings automatically."/>
                        </Grid>
                        <WrapPanel Margin="0,10,0,14">
                            <ui:Button Command="{Binding ApplyRecommendedCommand}" Content="Apply recommended settings…" Icon="{ui:SymbolIcon Sparkle24}" ToolTip="Lists every setting that differs from the recommendation for this kind of PC, then changes them after you confirm. Each can be switched back." />
                            <ui:Button Margin="8,0,0,0" Command="{Binding UndoRecommendedCommand}" Content="Undo recommended settings" ToolTip="Restore the exact switch values from before the last recommended-settings batch in this app session." Visibility="{Binding CanUndoRecommended, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding UndoFirstRunCommand}" Content="Undo setup settings" ToolTip="Preview and restore the saved settings and hold reasons from before the last first-time setup. Privacy switches have their own Undo on Privacy." Visibility="{Binding CanUndoFirstRun, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <TextBlock Margin="0,-6,0,14" Style="{StaticResource Subtle}" Text="{Binding RecommendedSummary}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Subtle}" Text="Temporary holds for whatever is going on with this PC. Each one shows its reason where it applies." TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Hold back driver updates" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Windows Update drivers are listed in Refresh but not ticked." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" AutomationProperties.Name="Hold back driver updates" IsChecked="{Binding HoldDriverUpdates}"  ToolTip="List Windows Update drivers without selecting them by default while you investigate a driver problem."/>
                        </Grid>
                        <ui:TextBox Margin="0,6,0,0" AutomationProperties.Name="Why drivers are held" PlaceholderText="Why? (shown next to each driver update)" Text="{Binding HoldDriverReason, UpdateSourceTrigger=PropertyChanged, Delay=500}" Visibility="{Binding HoldDriverUpdates, Converter={StaticResource BoolToVisibility}}"  ToolTip="Explain the temporary driver hold; this reason appears beside held driver updates."/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="Keep crash dumps and error reports" />
                                <TextBlock Style="{StaticResource Subtle}" Text="Cleanup leaves them unticked: they're the evidence for diagnosing blue screens." TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" AutomationProperties.Name="Keep crash dumps and error reports" IsChecked="{Binding KeepCrashEvidence}"  ToolTip="Keep crash evidence out of default Cleanup selections while you investigate blue screens."/>
                        </Grid>
                        <ui:TextBox Margin="0,6,0,0" AutomationProperties.Name="Why crash evidence is kept" PlaceholderText="Why? (shown in Cleanup)" Text="{Binding KeepCrashReason, UpdateSourceTrigger=PropertyChanged, Delay=500}" Visibility="{Binding KeepCrashEvidence, Converter={StaticResource BoolToVisibility}}"  ToolTip="Explain why crash evidence should be kept; this reason appears in Cleanup."/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelProtected" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Protected apps" /><ctl:HelpButton Topic="settings-protected-apps" /></StackPanel>
                <ui:Card Margin="0,0,0,4" Padding="16,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" Text="Apps whose name starts with any of these show a lock and can't be ticked or uninstalled (updates still run). One per line. Reset gives the basic list: runtimes, drivers and C.A.R.S. itself." TextWrapping="Wrap" />
                        <TextBox AutomationProperties.Name="Protected application prefixes" Height="180" Margin="0,8,0,8" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" Text="{Binding ProtectedText, UpdateSourceTrigger=PropertyChanged}" VerticalScrollBarVisibility="Auto"  ToolTip="One application-name prefix per line. Matching apps cannot be selected for uninstall; essential protections remain enforced."/>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding SaveProtectedCommand}" Content="Save"  ToolTip="Save the protected-application prefixes entered above."/>
                            <ui:Button Command="{Binding ResetProtectedCommand}" Content="Reset to defaults"  ToolTip="Preview the relevant reset and restore the built-in choices for this section."/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelIgnored" Visibility="Collapsed">
                <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitle}" Text="Ignored updates" />
                <ui:Card Margin="0,0,0,4" Padding="16,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" Text="Nothing ignored. To stop being offered an update, right-click it on Refresh and choose Skip this version or Ignore updates permanently." TextWrapping="Wrap" Visibility="{Binding IgnoreRules.Count, Converter={StaticResource ZeroToVisible}}" />
                        <ItemsControl ItemsSource="{Binding IgnoreRules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Key}" />
                                            <TextBlock Margin="12,0,0,0" Style="{StaticResource Subtle}" Text="{Binding Version, StringFormat='skipping {0}', TargetNullValue='all versions'}" />
                                        </StackPanel>
                                        <ui:Button HorizontalAlignment="Right" Command="{Binding Data.RemoveIgnoreCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Stop ignoring"  ToolTip="Offer this update again by removing the selected ignore rule."/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Margin="0,8,0,0" Command="{Binding ImportUniGetUiCommand}" Content="Import from UniGetUI" Visibility="{Binding UniGetUiImportAvailable, Converter={StaticResource BoolToVisibility}}"  ToolTip="Review update preferences from an existing UniGetUI configuration before importing them."/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelUpdates" Visibility="Collapsed">
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="About &amp; updates" /><ctl:HelpButton Topic="settings-self-update" /></StackPanel>
                <ui:Card Margin="0,0,0,12" Padding="16,12">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding AppVersionText}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Subtle}" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding InstallUpdateCommand}" Content="Update now" Icon="{ui:SymbolIcon ArrowCircleUp24}" Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVisibility}}"  ToolTip="Recheck the downloaded installer checksum, then start the C.A.R.S. update installer after your explicit action."/>
                            <ui:Button Margin="0,0,8,0" Command="{Binding CheckUpdatesNowCommand}" Content="Check now" Icon="{ui:SymbolIcon ArrowSync24}" IsEnabled="{Binding UpdateBusy, Converter={StaticResource InverseBool}}"  ToolTip="Check the configured GitHub repository for a compatible C.A.R.S. release; nothing installs automatically."/>
                            <ui:Button Margin="0,0,8,0" Command="{Binding SkipUpdateCommand}" Content="Skip this version" Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVisibility}}"  ToolTip="Do not offer this C.A.R.S. release again during automatic checks. A manual check can still show it."/>
                            <ui:Button Command="{Binding OpenReleasePageCommand}" Content="Release page"  ToolTip="Open this release on GitHub in your browser."/>
                            <ui:ProgressRing Width="18" Height="18" Margin="12,0,0,0" IsIndeterminate="True" Visibility="{Binding UpdateBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Expander Margin="0,12,0,0" Header="{Binding UpdateTitle}" IsExpanded="True" Visibility="{Binding UpdateNotes, Converter={StaticResource NullToCollapsed}}">
                            <TextBox AutomationProperties.Name="Protected application prefixes" Height="180" Margin="0,8,0,0" IsReadOnly="True" Text="{Binding UpdateNotes, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"  ToolTip="Read the release notes before installing this update." />
                        </Expander>
                    </StackPanel>
                </ui:Card>

                <ui:CardControl Margin="0,0,0,4" Header="Look for updates automatically" Icon="{ui:SymbolIcon Clock24}">
 <StackPanel Orientation="Horizontal"><ctl:RecommendedBadge Item="UpdatesAuto" /><ui:ToggleSwitch AutomationProperties.Name="Look for updates automatically" VerticalAlignment="Center" IsChecked="{Binding UpdatesAuto}"  ToolTip="Check for new C.A.R.S. releases at startup and daily, while no game is running. Installation still requires your action."/></StackPanel>
                </ui:CardControl>
                <TextBlock Margin="4,0,0,8" Style="{StaticResource Subtle}" Text="Once a day, never while you play. Nothing is installed without you pressing Update now." TextWrapping="Wrap" />
                <ui:CardControl Margin="0,0,0,12" Header="Also offer pre-releases (release candidates)" Icon="{ui:SymbolIcon Beaker24}">
 <StackPanel Orientation="Horizontal"><ctl:RecommendedBadge Item="UpdatesPre" /><ui:ToggleSwitch AutomationProperties.Name="Also offer pre-releases" VerticalAlignment="Center" IsChecked="{Binding UpdatesPre}"  ToolTip="Include release candidates and other testing builds in self-update results."/></StackPanel>
                </ui:CardControl>

                <ui:Card Margin="0,0,0,12" Padding="16,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Where updates come from" />
                        <TextBlock Style="{StaticResource Subtle}" Text="A GitHub repository (owner/name), checked over HTTPS, or through the GitHub CLI while the repository is private. Change it only to follow a fork." TextWrapping="Wrap" />
                        <ui:TextBox Width="320" Margin="0,8,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Update repository" PlaceholderText="CarCar08/cars-control" Text="{Binding UpdatesRepo, UpdateSourceTrigger=PropertyChanged, Delay=600}"  ToolTip="GitHub owner/repository used for C.A.R.S. updates. Only use a repository you trust to supply installers."/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Padding="16,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Help and source" />
                        <TextBlock Style="{StaticResource Subtle}" Text="Open source (MIT). Found a bug? The diagnostics contain no names or file paths." TextWrapping="Wrap" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0" Command="{Binding OpenProjectCommand}" Content="Project page" Icon="{ui:SymbolIcon Open24}"  ToolTip="Open the C.A.R.S. Control repository in your browser; access to the private repository requires your GitHub account."/>
                            <ui:Button Margin="0,0,8,0" Command="{Binding OpenLicensesCommand}" Content="Licenses" Icon="{ui:SymbolIcon Certificate24}" ToolTip="C.A.R.S. is MIT-licensed; this lists the open-source components it includes and their licences." />
                            <ui:Button Margin="0,0,8,0" Command="{Binding OpenIssuesCommand}" Content="Report a problem" Icon="{ui:SymbolIcon Bug24}"  ToolTip="Opens a bug report in your browser with the version, Windows build and .NET version filled in (no names or paths). You read and edit it; nothing is sent unless you submit it on GitHub."/>
                            <ui:Button Margin="0,0,8,0" Command="{Binding CopyDiagnosticsCommand}" Content="Copy diagnostics" Icon="{ui:SymbolIcon Copy24}"  ToolTip="Copy the application version, Windows build and runtime version; no app names or file paths are included."/>
                            <ui:Button Command="{Binding RunFirstRunCommand}" Content="Run the first-time setup again" Icon="{ui:SymbolIcon Wand24}"  ToolTip="Review this PC profile and optional features again. Choices are staged until the final review."/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>

            <StackPanel x:Name="PanelData" Visibility="Collapsed">
                <TextBlock Margin="0,0,0,10" Style="{StaticResource SectionTitle}" Text="Data" />
                <ui:Card Padding="16,12">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <TextBlock VerticalAlignment="Center" Text="{Binding SettingsPath, StringFormat='Your settings (plain JSON, safe to back up or edit): {0}'}" TextWrapping="Wrap" Margin="0,0,90,0" />
                            <ui:Button HorizontalAlignment="Right" Command="{Binding OpenCommand}" CommandParameter="{Binding SettingsPath}" Content="Show"  ToolTip="Open the displayed folder or file in its usual Windows application." />
                        </Grid>
                        <Grid Margin="0,6,0,2">
                            <TextBlock VerticalAlignment="Center" Text="{Binding DatabasePath, StringFormat='History, scans and update results: {0}'}" TextWrapping="Wrap" Margin="0,0,90,0" />
                            <ui:Button HorizontalAlignment="Right" Command="{Binding OpenCommand}" CommandParameter="{Binding DatabasePath}" Content="Show"  ToolTip="Open the displayed folder or file in its usual Windows application." />
                        </Grid>
                        <Grid Margin="0,6,0,2">
                            <TextBlock Text="{Binding UserQuarantine, StringFormat='Quarantined leftovers (yours): {0}'}" />
                            <ui:Button HorizontalAlignment="Right" Command="{Binding OpenCommand}" CommandParameter="{Binding UserQuarantine}" Content="Open"  ToolTip="Open the displayed folder or file in its usual Windows application." />
                        </Grid>
                        <Grid Margin="0,6,0,2">
                            <TextBlock Text="{Binding HelperLogs, StringFormat='Admin helper logs: {0}'}" />
                            <ui:Button HorizontalAlignment="Right" Command="{Binding OpenCommand}" CommandParameter="{Binding HelperLogs}" Content="Open"  ToolTip="Open the displayed folder or file in its usual Windows application." />
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
