<Page
    x:Class="CarsControl.App.Views.HealthPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:tabs="clr-namespace:CarsControl.App.Views.HealthTabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Health"
    ScrollViewer.CanContentScroll="False">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Health" />
                <TextBlock Style="{StaticResource Subtle}" Text="How this PC's parts are doing, and why it crashed, froze or woke up slowly" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding UpdatedText}" />
                <ui:Button Command="{Binding RefreshCommand}" Content="Re-check" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Read everything again" />
            </StackPanel>
        </Grid>

        <ui:InfoBar ctl:Notice.AutoDismiss="True"
            Grid.Row="1"
            Margin="0,0,0,4"
            IsClosable="True"
            IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}"
            Message="{Binding Banner}"
            Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}"
            Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />

        <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,8,0,0" SelectedIndex="{Binding SelectedTab, Converter={StaticResource TabIndex}, Mode=TwoWay}">
            <TabItem Header="Overview">
                <tabs:OverviewTab />
            </TabItem>
            <TabItem Header="Sensors">
                <tabs:SensorsTab />
            </TabItem>
            <TabItem Header="Drives">
                <tabs:DrivesTab />
            </TabItem>
            <TabItem Header="Crashes">
                <tabs:CrashesTab />
            </TabItem>
            <TabItem Header="Sleep &amp; boot">
                <tabs:SleepBootTab />
            </TabItem>
            <TabItem Header="Drivers">
                <tabs:DriversTab />
            </TabItem>
            <TabItem Header="Activity">
                <tabs:ActivityTab />
            </TabItem>
            <TabItem Header="Network">
                <tabs:NetworkTab />
            </TabItem>
        </TabControl>
    </Grid>
</Page>
