<Page
    x:Class="CarsControl.App.Views.CleanupPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Cleanup">
    <Page.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <DataTemplate x:Key="RuleTemplate">
            <ui:Card Margin="0,0,0,6" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="{Binding Title, StringFormat='Clean {0}'}" IsChecked="{Binding IsSelected}" ToolTip="Tick to clean this category." />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            <ctl:RecommendedBadge Recommendation="{Binding Recommendation}" />
                        </StackPanel>
                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Description}" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Warning}" Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                        <Expander Margin="0,4,0,0" Header="{Binding ItemsHeader}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Result}" Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                        <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Subtle}" Text="{Binding EstimateText}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Cleanup" />
                <TextBlock Style="{StaticResource Subtle}" Text="Caches and leftovers that are safe to clear. Sizes are measured first; nothing is touched until you press Clean." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ToggleSwitch Margin="0,0,16,0" Content="Dry run" IsChecked="{Binding DryRun}" ToolTip="Show what would be deleted without deleting anything." />
                <ui:Button Command="{Binding EstimateCommand}" Content="Measure again" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Measure every category again." />
            </StackPanel>
        </Grid>

        <ui:InfoBar ctl:Notice.AutoDismiss="True" Grid.Row="1" Margin="0,0,0,12" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />

        <ScrollViewer Grid.Row="2" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Your account" /><ctl:HelpButton Topic="cleanup-overview" /></StackPanel>
                <ItemsControl ItemTemplate="{StaticResource RuleTemplate}" ItemsSource="{Binding UserRows}" />
                <Grid Margin="0,16,0,8">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="System (needs admin)" />
                    <ui:Button HorizontalAlignment="Right" Command="{Binding EstimateAdminCommand}" Content="Measure admin items" Icon="{ui:SymbolIcon Shield24}" ToolTip="Measure the system categories (needs admin approval once)." />
                </Grid>
                <ItemsControl ItemTemplate="{StaticResource RuleTemplate}" ItemsSource="{Binding AdminRows}" />
            </StackPanel>
        </ScrollViewer>

        <ui:Card Grid.Row="3" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Summary}" />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" Appearance="Primary" Command="{Binding CleanCommand}" Content="Clean selected" Icon="{ui:SymbolIcon Broom24}" ToolTip="Delete what's ticked. Files in use are skipped and reported." />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
