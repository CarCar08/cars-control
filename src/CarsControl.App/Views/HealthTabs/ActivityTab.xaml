<UserControl
    x:Class="CarsControl.App.Views.HealthTabs.ActivityTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="clr-namespace:CarsControl.App.Services"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="0,12,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding ActivityTotals}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ctl:HelpButton Margin="0,0,12,0" Topic="health-activity" />
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Biggest by" />
                <ComboBox MinWidth="110" AutomationProperties.Name="Sort by" DisplayMemberPath="Label" ItemsSource="{Binding SortChoices}" SelectedValue="{Binding SortBy}" SelectedValuePath="Sort"  ToolTip="Choose the value used to order this list; use the direction button to reverse it."/>
                <CheckBox Margin="14,0,0,0" Content="Pause" IsChecked="{Binding ActivityPaused}" ToolTip="Stop updating so you can read or click" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Margin="0,2,0,8" Style="{StaticResource Subtle}" Text="{x:Static svc:Extras.ActivityIntro}" TextTrimming="None" TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2" FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="12,0,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Subtle}" Text="App" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Subtle}" Text="Processor" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Subtle}" Text="Graphics" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Subtle}" Text="Memory" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Subtle}" Text="Disk" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ActivityRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4" Padding="12,6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="6,0,0,0" Style="{StaticResource Subtle}" Text="{Binding Instances}" />
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding Role, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock FontSize="11" Text="{Binding Role}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Cpu}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Gpu}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Ram}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Disk}" />
                                    <StackPanel Grid.Column="5" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <ui:Button
                                            Padding="6,3"
                                            Appearance="Transparent"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in its folder'}"
                                            Command="{Binding Data.OpenActivityFolderCommand, Source={StaticResource Proxy}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Folder24}"
                                            IsEnabled="{Binding CanOpenFolder}"
                                            ToolTip="Show in its folder" />
                                        <ui:Button
                                            Padding="6,3"
                                            Appearance="Transparent"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Close {0}'}"
                                            Command="{Binding Data.EndAppCommand, Source={StaticResource Proxy}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Dismiss24}"
                                            IsEnabled="{Binding CanEnd}"
                                            ToolTip="{Binding EndToolTip}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
