<UserControl
    x:Class="CarsControl.App.Views.HealthTabs.DrivesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,24">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Every drive's own health report: how hot it runs, how worn it is and whether it has errors. NVMe drives share their numbers freely. For hard disks and SATA SSDs, Windows only gives the numbers to administrators: the button asks once." TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Subtle}" Text="{Binding DriveStatus}" TextTrimming="None" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal">
                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding DriveBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ctl:HelpButton Margin="0,0,8,0" Topic="health-drives" />
                    <ui:Button Command="{Binding ReadDriveCountersCommand}" Content="Read temperature, wear and errors" Icon="{ui:SymbolIcon HeartPulse24}" IsEnabled="{Binding DriveBusy, Converter={StaticResource InverseBool}}" ToolTip="Windows only shares these with administrators, so this asks for approval once" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding DriveRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LevelCard}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock FontSize="11" Text="{Binding KindText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Subtle}">
                                            <Run Text="{Binding SizeText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LettersText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="15" Style="{StaticResource LevelText}" Text="{Binding Summary}" />
                                </Grid>
                                <TextBlock Margin="0,6,0,0" Text="{Binding Notes}" TextWrapping="Wrap" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                                <Grid Margin="0,8,0,0" MaxWidth="1100" HorizontalAlignment="Left" Visibility="{Binding HasCounters, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" ToolTip="{Binding TemperatureTip}">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Temperature" />
                                        <TextBlock Text="{Binding Temperature}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" ToolTip="{Binding WearTip}">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Wear" />
                                        <TextBlock Text="{Binding Wear}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0" ToolTip="Total time this drive has been switched on.">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Powered on" />
                                        <TextBlock Text="{Binding Hours}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,12,0" ToolTip="{Binding ErrorsTip}">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Errors it couldn't fix" />
                                        <TextBlock Text="{Binding Errors}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0" MaxWidth="1100" HorizontalAlignment="Left" Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                        <ColumnDefinition Width="*" MinWidth="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" ToolTip="Everything ever written to the drive. SSD endurance is rated in terabytes written (TBW); compare with the maker's figure.">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Data written" />
                                        <TextBlock Text="{Binding Written}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" ToolTip="{Binding UnsafeTip}">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Unsafe shutdowns" />
                                        <TextBlock Text="{Binding UnsafeShutdowns}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0" ToolTip="How many times the drive has been switched on.">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Power cycles" />
                                        <TextBlock Text="{Binding PowerCycles}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,12,0" Visibility="{Binding IsNvme, Converter={StaticResource BoolToVisibility}}" ToolTip="NVMe drives keep spare blocks to replace worn ones. 100% is new; below the drive's limit it warns that it's running out.">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Spare area" />
                                        <TextBlock Text="{Binding Spare}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,12,0" Visibility="{Binding HasSectorData, Converter={StaticResource BoolToVisibility}}" ToolTip="Sectors the drive replaced with spares (replaced) or couldn't read and is waiting to replace (waiting). Rising numbers mean it's wearing out.">
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="Bad sectors" />
                                        <TextBlock Text="{Binding BadSectors}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,6,0,0" FontSize="11" Style="{StaticResource Subtle}" Text="{Binding Source}" Visibility="{Binding Source, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,6,0,0" FontSize="12" Style="{StaticResource Subtle}" Text="A phone alert goes out (if you've set those up) when a drive reports a problem, once a day per drive." TextTrimming="None" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
