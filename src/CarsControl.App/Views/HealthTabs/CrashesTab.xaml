<UserControl
    x:Class="CarsControl.App.Views.HealthTabs.CrashesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,24">
            <TextBlock Margin="0,0,0,12" Text="Every blue screen and unexpected shutdown Windows recorded, what each one blames, and apps that crashed. Use it to find the cause of crashes and freezes." TextWrapping="Wrap" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding CrashSummary}" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,10" Style="{StaticResource Subtle}" Text="{Binding DumpSummary}" TextTrimming="None" TextWrapping="Wrap" />

            <!--  the debugger  -->
            <ui:Card Margin="0,0,0,12" Padding="16,10" Visibility="{Binding HasDebugger, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="To find out what a blue screen blames, Windows' own debugger (WinDbg) has to read its crash dump. It isn't installed yet." TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Command="{Binding InstallDebuggerCommand}" Content="Install WinDbg" Icon="{ui:SymbolIcon ArrowDownload24}" IsEnabled="{Binding DebuggerBusy, Converter={StaticResource InverseBool}}" ToolTip="Install WinDbg, Microsoft's debugger, for your account (about 200 MB). Needed to analyze blue screens." />
                        <ui:ProgressRing Width="16" Height="16" Margin="12,0,8,0" IsIndeterminate="True" Visibility="{Binding DebuggerBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding DebuggerStatus}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  blue screens  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Blue screens" /><ctl:HelpButton Topic="health-crashes" /></StackPanel>
            <ItemsControl ItemsSource="{Binding BlueScreens}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <Border Style="{StaticResource Badge}">
                                            <TextBlock FontSize="11" Text="{Binding Code}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Subtle}" TextTrimming="None">
                                        <Run Text="{Binding When, Mode=OneWay}" />
                                        <Run Text="  ·  " />
                                        <Run Text="{Binding Ago, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0" Text="{Binding Meaning}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" Text="{Binding Analysis}" TextWrapping="Wrap" Visibility="{Binding Analysis, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="12" Style="{StaticResource Subtle}" Text="{Binding DumpName, StringFormat='Dump: {0}'}" Visibility="{Binding DumpName, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button
                                        AutomationProperties.Name="{Binding Name, StringFormat='Analyze {0}'}"
                                        Command="{Binding Data.AnalyzeCommand, Source={StaticResource Proxy}}"
                                        CommandParameter="{Binding}"
                                        Content="Analyze"
                                        Icon="{ui:SymbolIcon Bug24}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Visibility="{Binding CanAnalyze, Converter={StaticResource BoolToVisibility}}" ToolTip="Use WinDbg to read this crash dump; a protected dump may require an approved helper copy." />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button Margin="0,0,0,12" Padding="8,3" HorizontalAlignment="Left" Appearance="Transparent" Command="{Binding OpenDumpFolderCommand}" Content="Open the crash dump folder" Icon="{ui:SymbolIcon Folder24}" ToolTip="Open C:\Windows\Minidump in Explorer." />

            <!--  restarts without a clean shutdown  -->
            <StackPanel Margin="0,6,0,8" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Stopped without shutting down" /><ctl:HelpButton Topic="health-unsafe-shutdowns" /></StackPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource Subtle}" Text="Power cuts, a held power button, or a freeze you had to restart out of (no blue screen was recorded)." TextTrimming="None" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding ShutdownTimes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,2" Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  app crashes  -->
            <TextBlock Margin="0,18,0,8" Style="{StaticResource SectionTitle}" Text="Apps that crashed or hung (last 6 weeks)" />
            <ItemsControl ItemsSource="{Binding AppCrashList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{Binding App}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Counts}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Subtle}" Text="{Binding Last}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Subtle}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Reason, Mode=OneWay}" />
                                <Run Text="{Binding Module, StringFormat=' in {0}', Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
