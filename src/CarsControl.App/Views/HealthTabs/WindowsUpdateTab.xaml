<UserControl
    x:Class="CarsControl.App.Views.HealthTabs.WindowsUpdateTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,24">
            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,0,0,10" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />

            <!--  pause  -->
            <ui:Card Margin="0,0,0,10" Padding="16,12">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Pause updates" />
                    <TextBlock Margin="0,2,0,8" Text="{Binding PauseStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsPaused, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Pause for" />
                        <ComboBox MinWidth="70" AutomationProperties.Name="Days to pause" ItemsSource="{Binding PauseChoices}" SelectedItem="{Binding PauseDays}" ToolTip="How many days to pause Windows Update (up to 35). Security fixes wait too." />
                        <TextBlock Margin="8,0,16,0" VerticalAlignment="Center" Text="days" />
                        <ui:Button Command="{Binding PauseCommand}" Content="Pause" Icon="{ui:SymbolIcon Pause24}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Needs admin approval; Windows allows at most 35 days" />
                    </StackPanel>
                    <ui:Button Command="{Binding ResumeCommand}" Content="Resume updates" Icon="{ui:SymbolIcon Play24}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}" ToolTip="End the pause: Windows Update checks again right away." />
                </StackPanel>
            </ui:Card>

            <!--  drivers  -->
            <ui:Card Margin="0,0,0,10" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Keep drivers out of Windows Update" />
                        <TextBlock Style="{StaticResource Subtle}" Text="Windows stops swapping in its own graphics, chipset and other drivers; you update them from the maker when you choose. This is a Windows policy, so Settings shows “some settings are managed by your organization”." TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Keep drivers out of Windows Update" IsChecked="{Binding ExcludeDrivers}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Windows Update stops installing drivers; you update them from the maker. Shows as &quot;managed by your organization&quot; in Settings (it's a policy)." />
                </Grid>
            </ui:Card>

            <!--  feature updates  -->
            <ui:Card Margin="0,0,0,10" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Wait before big feature updates" />
                        <TextBlock Style="{StaticResource Subtle}" Text="The yearly Windows version upgrade arrives this many days after Microsoft offers it, so early bugs get found by others first. Security updates aren't delayed." TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <ComboBox MinWidth="70" AutomationProperties.Name="Days to delay feature updates" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ItemsSource="{Binding DeferChoices}" SelectedItem="{Binding DeferDays}" ToolTip="The yearly Windows upgrade arrives this many days after Microsoft offers it. Security updates aren't delayed." />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="days" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!--  active hours  -->
            <ui:Card Margin="0,0,0,10" Padding="16,12">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Active hours" />
                    <TextBlock Style="{StaticResource Subtle}" Text="{Binding ActiveStatus}" TextTrimming="None" TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="From" />
                        <ComboBox MinWidth="70" AutomationProperties.Name="Active hours start" ItemsSource="{Binding Hours}" SelectedItem="{Binding ActiveFrom}" ToolTip="Windows won't restart for updates between these hours." />
                        <TextBlock Margin="12,0,8,0" VerticalAlignment="Center" Text="to" />
                        <ComboBox MinWidth="70" AutomationProperties.Name="Active hours end" ItemsSource="{Binding Hours}" SelectedItem="{Binding ActiveTo}" ToolTip="Windows won't restart for updates between these hours." />
                        <ui:Button Margin="16,0,0,0" Command="{Binding SetActiveHoursCommand}" Content="Set" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Save these active hours (admin approval once)." />
                        <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding AutoActiveHoursCommand}" Content="Let Windows choose" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Let Windows pick active hours from when you use the PC." />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  hidden updates  -->
            <StackPanel Margin="0,12,0,6" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Updates you've hidden" /><ctl:HelpButton Topic="refresh-windows-update" /></StackPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource Subtle}" Text="{Binding HiddenStatus}" TextTrimming="None" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding HiddenUpdates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Detail}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" AutomationProperties.Name="{Binding Title, StringFormat='Show {0} again'}" Command="{Binding Data.ShowAgainCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Show again" ToolTip="Let Windows offer this update again." />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ui:Button Command="{Binding FindCandidatesCommand}" Content="See what Windows has waiting" Icon="{ui:SymbolIcon Search24}" IsEnabled="{Binding Searching, Converter={StaticResource InverseBool}}" ToolTip="Asks Windows Update (about 10 seconds). Hiding one needs admin approval." />
                <ui:ProgressRing Width="16" Height="16" Margin="12,0,0,0" IsIndeterminate="True" Visibility="{Binding Searching, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Candidates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Detail}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" AutomationProperties.Name="{Binding Title, StringFormat='Hide {0}'}" Command="{Binding Data.HideCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Hide" Icon="{ui:SymbolIcon EyeOff24}" ToolTip="Hide this update: Windows won't offer it again until you show it." />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  history  -->
            <TextBlock Margin="0,18,0,6" Style="{StaticResource SectionTitle}" Text="What Windows Update did recently" />
            <TextBlock Margin="0,0,0,6" Style="{StaticResource Subtle}" Text="{Binding HistoryStatus}" Visibility="{Binding HistoryStatus, Converter={StaticResource EmptyToCollapsed}}" />
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Subtle}" Text="{Binding When}" />
                            <TextBlock x:Name="Result" Grid.Column="1" Text="{Binding Result}" />
                            <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                <Setter TargetName="Result" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
