<Page
    x:Class="CarsControl.App.Views.HistoryPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ScrollViewer.CanContentScroll="False"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="History">
    <Page.Resources>
        <!--  Cells trim with "…" and show the full text on hover.  -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource EmptyToNull}}" />
        </Style>
    </Page.Resources>
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="History" />
                <TextBlock Style="{StaticResource Subtle}" Text="{Binding Summary}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding ExportCsvCommand}" Content="Export CSV" Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Save what is listed as a spreadsheet" />
                <ui:Button Command="{Binding ReloadCommand}" Content="Reload" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Read the history again." />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <WrapPanel>
                <ComboBox Width="280" Margin="0,0,12,6" AutomationProperties.Name="Show" ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}" ToolTip="Everything, only failures, or only what C.A.R.S. did (without imported UniGetUI history)." />
                <ComboBox Width="160" Margin="0,0,12,6" AutomationProperties.Name="Date range" ItemsSource="{Binding RangeOptions}" SelectedIndex="{Binding RangeIndex}" ToolTip="Limit the list to a period." />
                <ui:TextBox
                    Width="300"
                    Margin="0,0,12,6"
                    AutomationProperties.Name="Search history"
                    ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Search24}"
                    PlaceholderText="Search app, action or details"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"  ToolTip="Filter recorded operations by title or detail without changing the saved history."/>
                <ui:Button Margin="0,0,0,6" Appearance="Transparent" Command="{Binding ResetFiltersCommand}" Content="Reset filters" ToolTip="Clear the search, the kind chips and the date range." />
            </WrapPanel>
            <ItemsControl AutomationProperties.Name="Kinds of operation" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding Kinds}" />
        </StackPanel>

        <!--  Shown over the empty list: CollectionView raises IsEmpty changes as filters apply.  -->
        <TextBlock Grid.Row="2" Margin="8,48,8,0" VerticalAlignment="Top" Panel.ZIndex="1" Style="{StaticResource Subtle}" Text="{Binding EmptyText}" TextWrapping="Wrap" Visibility="{Binding View.IsEmpty, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False" />
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            GridLinesVisibility="None"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding View}"
            RowHeight="36"
            SelectedItem="{Binding Selected}"
            SelectionMode="Single"
            VirtualizingPanel.ScrollUnit="Pixel">
            <DataGrid.Columns>
                <DataGridTextColumn Width="130" Binding="{Binding When}" ElementStyle="{StaticResource Cell}" Header="When" SortMemberPath="Entry.Started" />
                <DataGridTextColumn Width="2*" MinWidth="170" Binding="{Binding Title}" ElementStyle="{StaticResource Cell}" Header="App" />
                <DataGridTextColumn Width="84" Binding="{Binding KindText}" ElementStyle="{StaticResource Cell}" Header="Action" />
                <DataGridTextColumn Width="150" Binding="{Binding Versions}" ElementStyle="{StaticResource Cell}" Header="Version" />
                <DataGridTemplateColumn Width="112" Header="Result" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock x:Name="S" Text="{Binding Status}" />
                                <ui:SymbolIcon
                                    Margin="6,0,0,0"
                                    FontSize="12"
                                    Symbol="Shield24"
                                    ToolTip="Ran as admin"
                                    Visibility="{Binding Elevated, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                    <Setter TargetName="S" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="120" Binding="{Binding SourceText}" ElementStyle="{StaticResource Cell}" Header="Via" />
                <DataGridTextColumn Width="3*" MinWidth="200" Binding="{Binding Message}" ElementStyle="{StaticResource Cell}" Header="Details" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  Output of the selected operation (hidden until you pick one)  -->
        <ui:Card
            Grid.Row="3"
            Height="230"
            Margin="0,12,0,0"
            Padding="12"
            Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Selected.Title}" TextTrimming="CharacterEllipsis" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding RestoreMessage}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding RestoreCommand}"
                            Content="Restore these leftovers"
                            Icon="{ui:SymbolIcon ArrowUndo24}"
                            Visibility="{Binding Selected.CanRestore, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" ToolTip="Put quarantined files and registry values back in their original locations." />
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding FindLeftoversCommand}"
                            Content="Find leftovers…"
                            Icon="{ui:SymbolIcon Search24}"
                            ToolTip="Look again for folders, registry keys and shortcuts this app left behind"
                            Visibility="{Binding Selected.CanFindLeftovers, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        <ui:Button Command="{Binding CopyOutputCommand}" Content="Copy" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy the full output of the selected operation." />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" FocusVisualStyle="{x:Null}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Text="{Binding SelectedOutput}"
                        TextWrapping="NoWrap" />
                </ScrollViewer>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
