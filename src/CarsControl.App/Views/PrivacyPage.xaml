<Page
    x:Class="CarsControl.App.Views.PrivacyPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Privacy"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Privacy" />
                    <TextBlock Style="{StaticResource Subtle}" Text="Turn off tracking, ads and AI extras. Every switch shows what's set right now and can be switched back. Nothing here weakens security: Defender, SmartScreen, the firewall, UAC (the admin prompt) and Windows Update stay as they are." TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding Summary}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="Re-check" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Read every setting again (something else may have changed them)" />
                    <ui:Button Appearance="Primary" Command="{Binding ApplyAllRecommendedCommand}" Content="Turn all on" Icon="{ui:SymbolIcon ShieldCheckmark24}" ToolTip="Every switch that's off (one admin prompt at most). Switches with a warning for this PC are left alone." />
                </StackPanel>
            </Grid>

            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,0,0,12" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />

            <!--  Switch groups  -->
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding Summary}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Subtle}" Text="{Binding Description}" TextWrapping="Wrap" TextTrimming="None" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Appearance="Transparent"
                                    Command="{Binding Data.ApplyGroupCommand, Source={StaticResource Proxy}}"
                                    CommandParameter="{Binding}"
                                    Content="Turn this group on" ToolTip="Apply suggested switches in this group, leaving switches with a caution alone. Each switch keeps its own undo snapshot."
                                    Visibility="{Binding AllOn, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                            <ui:Card Padding="16,6">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="Row" Margin="0,8" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel ToolTip="{Binding Details}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                                        <Border Margin="10,0,6,0" Style="{StaticResource Tag}" ToolTip="{Binding ScopeTip}">
                                                            <TextBlock FontSize="11" Text="{Binding ScopeText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Tag}" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Margin="0,0,3,0" FontSize="11" Symbol="Shield24" />
                                                                <TextBlock FontSize="11" Text="admin" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ctl:RecommendedBadge Recommendation="{Binding Recommendation}" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Subtle}" Text="{Binding Description}" TextWrapping="Wrap" />
                                                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Note}" TextWrapping="Wrap" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Caution}" TextWrapping="Wrap" Visibility="{Binding HasCaution, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Status}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                                    <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button
                                                        x:Name="DefaultButton"
                                                        Margin="0,0,8,0"
                                                        Padding="8,3"
                                                        Appearance="Transparent"
                                                        Command="{Binding DefaultCommand}"
                                                        Visibility="Hidden"
                                                        Content="Windows default"
                                                        FontSize="12"
                                                        ToolTip="Remove C.A.R.S.'s change and any policy: back to how Windows ships" />
                                                    <ui:ToggleSwitch AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="On: the privacy-friendly setting is applied. Off: puts back exactly what was there before." />
                                                </StackPanel>
                                            </Grid>
                                            <!--  "Windows default" only where you're pointing or tabbing: on every row it was noise  -->
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DefaultButton" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter TargetName="DefaultButton" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ui:Card>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Store add-ons  -->
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Apps that came with Windows" /><ctl:HelpButton Topic="privacy-store-apps" /></StackPanel>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding AddOnSummary}" />
                </StackPanel>
            </Grid>
            <ui:Card Margin="0,0,0,16" Padding="16,6">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding InstalledAddOns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Subtle}" Text="{Binding Why}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Command="{Binding Data.RemoveAddOnCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Remove" Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove this app for your account. It can be reinstalled from the Microsoft Store." />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,8,0,4" Visibility="{Binding RemovedAddOns.Count, Converter={StaticResource ZeroToCollapsed}}">
                    <TextBlock Style="{StaticResource Subtle}" Text="Not installed. Click one to get it back from the Microsoft Store:" />
                    <ItemsControl Margin="0,6,0,0" ItemsPanel="{StaticResource WrapItems}" ItemsSource="{Binding RemovedAddOns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Margin="0,0,6,6" Padding="10,3" Command="{Binding Data.ReinstallAddOnCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="{Binding Title}" FontSize="12" ToolTip="{Binding Why}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  Camera, microphone, location  -->
            <TextBlock Margin="0,0,0,4" Style="{StaticResource SectionTitle}" Text="Who used your camera, microphone and location" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="From Windows' own record (Settings › Privacy › Recent activity). Read only; it never leaves this PC." TextWrapping="Wrap" />
            <ui:Card Padding="16,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" Text="No app has used them yet." Visibility="{Binding HasAccesses, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Accesses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" ToolTip="{Binding Path, Converter={StaticResource EmptyToNull}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding App}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Subtle}" Text="{Binding Capability}" />
                                    <TextBlock x:Name="When" Grid.Column="2" Style="{StaticResource Subtle}" Text="{Binding When}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding InUse}" Value="True">
                                        <Setter TargetName="When" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        <Setter TargetName="When" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
