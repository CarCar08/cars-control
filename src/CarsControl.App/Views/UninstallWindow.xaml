<ui:FluentWindow
    x:Class="CarsControl.App.Views.UninstallWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Uninstall"
    Width="900"
    Height="680"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="C.A.R.S. Control" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <TextBlock Style="{StaticResource PageTitle}" FontSize="24" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Subtle}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
            <ProgressBar
                Height="4"
                Margin="0,10,0,0"
                Value="{Binding Progress, Mode=OneWay}"
                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!--  Apps (review + running + done)  -->
        <ScrollViewer
            Grid.Row="2"
            Margin="24,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding IsLeftovers, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,4" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource Subtle}" Text="{Binding SizeText}" />
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Margin="0,0,4,0" FontSize="11" Symbol="Shield24" />
                                                <TextBlock FontSize="11" Text="Admin" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="11" Text="Needs your clicks" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding MethodText}" />
                                    <TextBlock
                                        FontSize="12"
                                        Style="{StaticResource Subtle}"
                                        Text="{Binding LastLine}"
                                        Visibility="{Binding LastLine, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock
                                        x:Name="Status"
                                        FontSize="12"
                                        Text="{Binding StatusText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="CheckmarkCircle24" Visibility="{Binding IsOk, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ErrorCircle24" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  Leftovers  -->
        <Grid Grid.Row="2" Margin="24,0" Visibility="{Binding IsLeftovers, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="These were left behind. High-confidence items are ticked; review the rest before including them." TextWrapping="Wrap" />
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                ItemsSource="{Binding Leftovers}"
                RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox MinWidth="0" Margin="10,0,0,0" IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="140" Binding="{Binding AppName}" Header="App" IsReadOnly="True" />
                    <DataGridTextColumn Width="80" Binding="{Binding KindText}" Header="Type" IsReadOnly="True" />
                    <DataGridTextColumn Width="3*" Binding="{Binding Path}" Header="Location" IsReadOnly="True" />
                    <DataGridTextColumn Width="80" Binding="{Binding SizeText}" Header="Size" IsReadOnly="True" />
                    <DataGridTextColumn Width="80" Binding="{Binding ConfidenceText}" Header="Match" IsReadOnly="True" />
                    <DataGridTextColumn Width="2*" Binding="{Binding Reason}" Header="Why" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!--  Footer  -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="24,14" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid>
                <!--  Review  -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Content="Create a restore point first" IsChecked="{Binding CreateRestorePoint}" Visibility="{Binding AnyMachine, Converter={StaticResource BoolToVisibility}}" ToolTip="Request a Windows restore point before uninstalling; Windows System Protection must be enabled." />
                    <ui:ToggleSwitch Margin="16,0,0,0" Content="Dry run" IsChecked="{Binding DryRun}" ToolTip="Show the planned operations without uninstalling or removing files." />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Margin="0,0,8,0" Command="{Binding CloseCommand}" Content="Cancel" ToolTip="Close this review without starting the operation." />
                    <ui:Button Appearance="Danger" Command="{Binding StartCommand}" Content="Uninstall" Icon="{ui:SymbolIcon Delete24}" ToolTip="Run the removal plan shown above, then check that the installed app entry is gone." />
                </StackPanel>

                <!--  Leftovers  -->
                <TextBlock VerticalAlignment="Center" Text="{Binding LeftoverSummary}" Visibility="{Binding IsLeftovers, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Visibility="{Binding IsLeftovers, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Margin="0,0,8,0" Command="{Binding SkipLeftoversCommand}" Content="Leave them" ToolTip="Keep the detected leftover files and registry values unchanged." />
                    <ui:Button Appearance="Primary" Command="{Binding QuarantineCommand}" Content="Quarantine selected" ToolTip="Move the selected leftovers into quarantine, where History can restore them." />
                </StackPanel>

                <!--  Done  -->
                <ui:Button HorizontalAlignment="Right" Appearance="Primary" Command="{Binding CloseCommand}" Content="Done" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" ToolTip="Close the completed operation and keep its result in History." />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
