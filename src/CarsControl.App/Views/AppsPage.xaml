<Page
    x:Class="CarsControl.App.Views.AppsPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:tabs="clr-namespace:CarsControl.App.Views.AppsTabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Apps"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </Page.Resources>
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="Apps" />
            <TextBlock Style="{StaticResource Subtle}" Text="What's installed, new apps to get, and what starts with Windows" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="Installed">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Summary}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ProgressRing Width="20" Height="20" Margin="0,0,12,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <ui:ToggleSwitch Margin="0,0,16,0" Content="Details" IsChecked="{Binding IsDetailsOpen}" ToolTip="Show the selected app's details (or double-click a row)" />
                <ui:Button Command="{Binding RefreshCommand}" Content="Rescan" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Read the list of installed apps again (from the registry, the Store and winget). Sizes are measured in the background." />
            </StackPanel>
        </Grid>

        <ui:InfoBar ctl:Notice.AutoDismiss="True"
            Title="Update info unavailable"
            Grid.Row="1"
            Margin="0,0,0,12"
            IsClosable="True"
            IsOpen="{Binding Error, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}"
            Message="{Binding Error}"
            Severity="Warning"
            Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />

        <!--  Filters  -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" AutomationProperties.Name="Search apps" Icon="{ui:SymbolIcon Search24}" PlaceholderText="Search name, publisher or winget id" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type part of an app's name, its publisher or its winget id." />
            <ComboBox Grid.Column="1" MinWidth="150" Margin="12,0,0,0" ItemsSource="{Binding KindOptions}" SelectedIndex="{Binding KindIndex}" />
            <ComboBox Grid.Column="2" MinWidth="140" Margin="12,0,0,0" ItemsSource="{Binding ScopeOptions}" SelectedIndex="{Binding ScopeIndex}" />
            <CheckBox Grid.Column="3" Margin="16,0,0,0" Content="Has update" IsChecked="{Binding UpdatesOnly}" ToolTip="Show only apps with an update waiting." />
        </Grid>

        <!--  List + details  -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid
                x:Name="Grid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                EnableRowVirtualization="True"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ItemsSource="{Binding View}"
                MouseDoubleClick="OnRowDoubleClick"
                PreviewMouseRightButtonDown="OnPreviewRightClick"
                RowHeight="44"
                SelectedItem="{Binding Selected}"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ShowDetailsCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Details" Icon="{ui:SymbolIcon Info24}" />
                        <Separator />
                        <MenuItem Command="{Binding UpdateNowCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Update now" Icon="{ui:SymbolIcon ArrowDownload24}" />
                        <MenuItem Command="{Binding UninstallOneCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Uninstall…" Icon="{ui:SymbolIcon Delete24}" />
                        <MenuItem Command="{Binding ToggleProtectCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="{Binding PlacementTarget.SelectedItem.ProtectText, RelativeSource={RelativeSource AncestorType=ContextMenu}, FallbackValue='Protect / Unprotect'}" Icon="{ui:SymbolIcon LockClosed24}" ToolTip="Protected apps show a lock and can't be ticked or uninstalled until you unprotect them. Updates still work. The list is in Settings › Protected apps." />
                        <Separator />
                        <MenuItem Command="{Binding OpenLocationCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Open install folder" Icon="{ui:SymbolIcon FolderOpen24}" />
                        <MenuItem Command="{Binding CopyNameCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Copy name" Icon="{ui:SymbolIcon Copy24}" />
                        <MenuItem Command="{Binding CopyWingetIdCommand}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Copy winget id" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="48" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    MinWidth="0"
                                    Margin="12,0,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}"
                                    IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanSelect}"
                                    ToolTip="{Binding SelectTooltip, Converter={StaticResource EmptyToNull}}"
                                    ToolTipService.ShowOnDisabled="True" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="3*" MinWidth="200" MaxWidth="560" Header="Name" IsReadOnly="True" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="24" Height="24" HorizontalAlignment="Left">
                                        <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:SymbolIcon FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="AppGeneric24" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name, Converter={StaticResource EmptyToNull}}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Background>
                                                <SolidColorBrush Opacity="0.25" Color="{DynamicResource SystemAccentColor}" />
                                            </Border.Background>
                                            <TextBlock FontSize="11" Text="{Binding AvailableVersion, StringFormat='↑ {0}'}" />
                                        </Border>
                                        <ui:SymbolIcon Margin="8,0,4,0" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="LockClosed24" ToolTip="Protected: can't be uninstalled until you right-click › Unprotect" Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1.5*" MinWidth="110" MaxWidth="340" Header="Publisher" IsReadOnly="True" SortMemberPath="Publisher">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Publisher}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Publisher, Converter={StaticResource EmptyToNull}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*" MinWidth="84" MaxWidth="220" Header="Version" IsReadOnly="True" SortMemberPath="Version">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Version}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Version, Converter={StaticResource EmptyToNull}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="84" Binding="{Binding ScopeText}" Header="For" IsReadOnly="True" />
                    <DataGridTemplateColumn Width="86" Header="Size" IsReadOnly="True" SortMemberPath="SizeBytes">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding SizeText}" TextAlignment="Right" ToolTip="{Binding SizeTooltip, Converter={StaticResource EmptyToNull}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Width="96" Binding="{Binding InstallDateText}" Header="Installed" IsReadOnly="True" SortMemberPath="InstallDateSort" Visibility="{Binding Data.IsDetailsOpen, Source={StaticResource Proxy}, Converter={StaticResource InverseBoolToVisibility}}" />
                    <DataGridTextColumn Width="110" Binding="{Binding ChannelText}" Header="Updates via" IsReadOnly="True" Visibility="{Binding Data.IsDetailsOpen, Source={StaticResource Proxy}, Converter={StaticResource InverseBoolToVisibility}}" />
                </DataGrid.Columns>
            </DataGrid>

            <!--  Details panel  -->
            <ui:Card
                x:Name="DetailsCard"
                Grid.Column="1"
                Width="340"
                Margin="12,0,0,0"
                Padding="16"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top"
                Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                <TextBlock Style="{StaticResource Subtle}" Text="Select an app in the list to see its details." TextWrapping="Wrap" Visibility="{Binding HasSelected, Converter={StaticResource InverseBoolToVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Selected}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="40" Height="40" Margin="0,0,12,0">
                                    <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:SymbolIcon FontSize="32" Symbol="AppGeneric24" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                                <StackPanel MaxWidth="220" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Subtle}" Text="{Binding Publisher}" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Appearance="Transparent"
                                Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                Icon="{ui:SymbolIcon Dismiss24}"
                                ToolTip="Close details" />
                        </Grid>

                        <TextBlock Margin="0,14,0,2" Style="{StaticResource Subtle}" Text="Version" />
                        <TextBlock Text="{Binding VersionDisplay}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Updates" />
                        <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Installed for" />
                        <TextBlock Text="{Binding ScopeText}" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Size" />
                        <TextBlock Text="{Binding SizeText}" ToolTip="{Binding SizeTooltip, Converter={StaticResource EmptyToNull}}" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Installed on" />
                        <TextBlock Text="{Binding InstallDateText}" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Location" />
                        <TextBlock Text="{Binding InstallLocation, TargetNullValue='Not recorded'}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Uninstalls with" />
                        <TextBlock Text="{Binding UninstallText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="winget id" Visibility="{Binding HasWingetId, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding WingetId}" TextWrapping="Wrap" Visibility="{Binding HasWingetId, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Source" />
                        <TextBlock FontSize="12" Text="{Binding SourceText}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,2" Style="{StaticResource Subtle}" Text="Last C.A.R.S. action" />
                        <TextBlock Text="{Binding LastAction}" TextWrapping="Wrap" />

                        <WrapPanel Margin="0,16,0,0">
                            <ui:Button
                                Margin="0,0,6,6"
                                Appearance="Primary"
                                Command="{Binding DataContext.UpdateNowCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="Update now"
                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" ToolTip="Install the available update for this app through its configured update source." />
                            <ui:Button
                                Margin="0,0,6,6"
                                Command="{Binding DataContext.UninstallOneCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="Uninstall…"
                                Icon="{ui:SymbolIcon Delete24}" ToolTip="Review the removal plan for this app before anything is uninstalled." />
                            <ui:Button
                                Margin="0,0,6,6"
                                Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="Folder"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Visibility="{Binding HasInstallLocation, Converter={StaticResource BoolToVisibility}}" ToolTip="Open this item in its folder in File Explorer." />
                            <ui:Button
                                Margin="0,0,6,6"
                                Command="{Binding DataContext.ToggleProtectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}"
                                Content="{Binding ProtectText}"
                                Icon="{ui:SymbolIcon LockClosed24}"
                                ToolTip="Protected apps show a lock and can't be ticked or uninstalled until you unprotect them. Updates still work. The list is in Settings › Protected apps." />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ActionStatus, Converter={StaticResource NullToCollapsed}}">
                            <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock MaxWidth="290" FontSize="12" Text="{Binding ActionStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </ui:Card>
        </Grid>

        <!--  Selection bar  -->
        <ui:Card Grid.Row="4" Margin="0,12,0,0" Padding="16,10" Visibility="{Binding HasChecked, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBlock VerticalAlignment="Center" Text="{Binding CheckedSummary}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Command="{Binding ClearSelectionCommand}" Content="Clear" ToolTip="Untick everything." />
                    <ui:Button Appearance="Danger" Command="{Binding UninstallSelectedCommand}" Content="Uninstall selected" Icon="{ui:SymbolIcon Delete24}" ToolTip="Uninstall every ticked app, one after another. You see a review first; protected apps are skipped." />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
            </TabItem>
            <TabItem Header="Get apps">
                <tabs:GetAppsTab />
            </TabItem>
            <TabItem Header="Startup">
                <tabs:StartupTab />
            </TabItem>
            <TabItem Header="Right-click menu">
                <tabs:ContextMenuTab />
            </TabItem>
        </TabControl>
    </Grid>
</Page>
