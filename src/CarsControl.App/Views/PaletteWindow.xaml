<Window
    x:Class="CarsControl.App.Views.PaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="C.A.R.S. Control — command palette"
    Width="660"
    MaxHeight="520"
    AutomationProperties.Name="Command palette"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">
    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TextBox
                x:Name="SearchBox"
                Margin="12,12,12,8"
                AutomationProperties.Name="Search commands"
                ClearButtonEnabled="False"
                FontSize="16"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="{Binding Placeholder}"
                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Find actions, pages, apps, settings and explanations; use the arrow keys to choose a result." />

            <ListBox
                x:Name="Results"
                Grid.Row="1"
                MaxHeight="400"
                Margin="6,0,6,4"
                AutomationProperties.Name="Results"
                Background="Transparent"
                BorderThickness="0"
                FocusVisualStyle="{x:Null}"
                ItemsSource="{Binding Rows}"
                MouseLeftButtonUp="OnResultClicked"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItem="{Binding Selected}"
                VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Focusable" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Padding" Value="8,8,8,2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Opacity="0.7" Text="{Binding Header}" Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibility}}" />
                            <Grid Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Margin="0,0,12,0" VerticalAlignment="Center" FontSize="18" Symbol="{Binding Item.Icon}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Item.Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Opacity="0.7" Text="{Binding Item.Subtitle}" TextTrimming="CharacterEllipsis" Visibility="{Binding Item.Subtitle, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Opacity="0.6" Text="more →" Visibility="{Binding Item.HasMore, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Margin="20,8,20,16" Opacity="0.7" Text="Nothing matches. Try fewer letters, or a page, app or game name." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <Border Grid.Row="2" Padding="14,6" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <TextBlock FontSize="11" Opacity="0.75" Text="{Binding Hint}" />
            </Border>
        </Grid>
    </Border>
</Window>
