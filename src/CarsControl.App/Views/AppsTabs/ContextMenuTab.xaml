<UserControl
    x:Class="CarsControl.App.Views.AppsTabs.ContextMenuTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,24">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,10" Style="{StaticResource Subtle}" Text="Apps add things to the menu you get when you right-click a file or folder, and they pile up. Switching one off hides it for your account only; nothing is uninstalled, and the switch brings it back." TextTrimming="None" TextWrapping="Wrap" />

            <!--  C.A.R.S.'s own items  -->
            <ui:Card Margin="0,0,0,12" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Add C.A.R.S. to the right-click menu" />
                        <TextBlock Style="{StaticResource Subtle}" Text="“Folder size in C.A.R.S.” on folders and “Scan this drive in C.A.R.S.” on drives: they open Storage there. Just for your account." TextTrimming="None" TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Add C.A.R.S. to the right-click menu" IsChecked="{Binding CarsEntries}" ToolTip="Adds &quot;Folder size in C.A.R.S.&quot; when you right-click a folder and &quot;Scan this drive in C.A.R.S.&quot; on drives. Just for your account; switch off to remove." />
                </Grid>
            </ui:Card>

            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,0,0,8" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox AutomationProperties.Name="Where it shows up" ItemsSource="{Binding PlaceChoices}" SelectedIndex="{Binding PlaceIndex}" ToolTip="Show entries for files, folders, drives or the empty space in a folder." />
                <ui:TextBox Grid.Column="1" Margin="8,0,0,0" AutomationProperties.Name="Filter right-click items" ClearButtonEnabled="True" PlaceholderText="Filter by name or maker" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type part of an entry's name or the app that added it." />
                <CheckBox Grid.Column="2" Margin="16,0,0,0" Content="Hide Microsoft's own" IsChecked="{Binding ThirdPartyOnly}" ToolTip="Hide Windows' own entries so the list shows only what other apps added." />
            </Grid>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,4" Padding="14,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel ToolTip="{Binding Command}">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Detail}" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Warning}" TextWrapping="Wrap" Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding Place}" />
                                <ui:ToggleSwitch Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in the right-click menu'}" IsChecked="{Binding Shown}" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBool}}" ToolTip="On: the entry is in the menu. Off: hidden for your account (nothing is uninstalled)." />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
