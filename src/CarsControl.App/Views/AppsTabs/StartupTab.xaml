<UserControl
    x:Class="CarsControl.App.Views.AppsTabs.StartupTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="StartupRow">
            <Grid x:Name="Row" Margin="0,6" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel ToolTip="{Binding Command}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource Badge}" ToolTip="Changing it goes through the admin helper" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,3,0" FontSize="11" Symbol="Shield24" />
                                <TextBlock FontSize="11" Text="admin" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Detail}" />
                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Note}" TextTrimming="None" TextWrapping="Wrap" Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Status}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        x:Name="FolderButton"
                        Margin="0,0,8,0"
                        Padding="6,3"
                        Appearance="Transparent"
                        AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in its folder'}"
                        Command="{Binding OpenFolderCommand}"
                        Icon="{ui:SymbolIcon Folder24}"
                        ToolTip="Show in its folder"
                        Visibility="Hidden" />
                    <ui:ToggleSwitch AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="On: it starts by itself. Off: it stays installed but doesn't start by itself. The same switch as Task Manager's Startup tab." />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="FolderButton" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="FolderButton" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,24">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding Summary}" />
                <ui:TextBox Grid.Column="1" AutomationProperties.Name="Filter start-up items" ClearButtonEnabled="True" PlaceholderText="Filter by name or maker" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type part of a name or maker to narrow the lists." />
                <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal">
                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Command="{Binding RefreshCommand}" Content="Re-check" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Read what starts with Windows again." />
                </StackPanel>
            </Grid>
            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,0,0,8" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Margin="0,0,0,10" Style="{StaticResource Subtle}" Text="Switching one off keeps it installed; it just doesn't start by itself. The switches are the same ones Task Manager's Startup tab uses, so the two always agree." TextTrimming="None" TextWrapping="Wrap" />

            <StackPanel Margin="0,4,0,6" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Apps" /><ctl:HelpButton Topic="apps-startup" /></StackPanel>
            <ui:Card Margin="0,0,0,12" Padding="16,4">
                <ItemsControl ItemTemplate="{StaticResource StartupRow}" ItemsSource="{Binding Apps}" />
            </ui:Card>

            <StackPanel Margin="0,4,0,2" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Services" /><ctl:HelpButton Topic="apps-services" /></StackPanel>
            <TextBlock Margin="0,0,0,6" Style="{StaticResource Subtle}" Text="Background programs that aren't from Microsoft. “Off” means they start only when something needs them, which is safe; right-click one to disable it completely." TextTrimming="None" TextWrapping="Wrap" />
            <ui:Card Margin="0,0,0,12" Padding="16,4">
                <ItemsControl ItemTemplate="{StaticResource StartupRow}" ItemsSource="{Binding Services}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding DisableCompletelyCommand}" Header="Disable completely…" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ui:Card>

            <StackPanel Margin="0,4,0,6" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Scheduled tasks" /><ctl:HelpButton Topic="apps-tasks" /></StackPanel>
            <ui:Card Margin="0,0,0,12" Padding="16,4">
                <ItemsControl ItemTemplate="{StaticResource StartupRow}" ItemsSource="{Binding Tasks}" />
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
