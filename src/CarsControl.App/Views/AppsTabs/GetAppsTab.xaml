<UserControl
    x:Class="CarsControl.App.Views.AppsTabs.GetAppsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>
    <Grid Margin="0,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox AutomationProperties.Name="Search for apps to install" ClearButtonEnabled="True" PlaceholderText="Search apps to install (winget and the Microsoft Store)" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by name, publisher or what the app does (&quot;pdf&quot;, &quot;screenshot&quot;).">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Command="{Binding SearchCommand}" Content="Search" ToolTip="Search winget's catalog (and the Microsoft Store, if ticked)." Icon="{ui:SymbolIcon Search24}" IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBool}}" />
            <CheckBox Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Content="Include the Microsoft Store" IsChecked="{Binding IncludeStore}" ToolTip="Also search the Microsoft Store. Store apps install and update through the Store." />
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ui:Button Command="{Binding OpenListCommand}" Content="Open a list…" Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open an app list (from C.A.R.S. or winget export) to install everything on it" />
                <ui:Button Margin="8,0,0,0" Command="{Binding SaveInstalledCommand}" Content="Save what I have…" Icon="{ui:SymbolIcon DocumentSave24}" ToolTip="Save the apps installed here that winget knows, as a list for a new PC" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,0,0,6" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding Status}" />
            </StackPanel>
            <ui:Card Margin="0,0,0,8" Padding="14,10" Visibility="{Binding Current, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Current.Name}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Detail}" TextWrapping="Wrap" />
                    <ui:Button Margin="0,6,0,0" Padding="8,3" HorizontalAlignment="Left" Appearance="Transparent" Command="{Binding OpenDetailLinkCommand}" Content="Open its website" Icon="{ui:SymbolIcon Open24}" Visibility="{Binding DetailLink, Converter={StaticResource NullToCollapsed}}" ToolTip="Open the app's website in your browser." />
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,4" Padding="12,8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsInstalled, Converter={StaticResource InverseBool}}" ToolTip="Tick apps to save them as a list or install several at once." />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock FontSize="11" Text="{Binding SourceText}" />
                                            </Border>
                                            <TextBlock Margin="10,0,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding InstalledText}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock FontSize="12" Style="{StaticResource Subtle}">
                                            <Run Text="{Binding Publisher, Mode=OneWay}" />
                                            <Run Text="{Binding Id, StringFormat='  ·  {0}', Mode=OneWay}" />
                                            <Run Text="{Binding Version, StringFormat='  ·  {0}', Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock x:Name="Line" FontSize="12" Text="{Binding Status}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Padding="6,3" Appearance="Transparent" AutomationProperties.Name="{Binding Name, StringFormat='About {0}'}" Command="{Binding Data.ShowDetailCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Info24}" ToolTip="What it is" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Failed}" Value="True">
                                    <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <ui:Card Grid.Row="3" Margin="0,10,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />
                <ui:Button Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Left" Command="{Binding SaveListCommand}" Content="Save ticked as a list…" IsEnabled="{Binding HasSelection}" ToolTip="Save the ticked apps as a list file, to install them later or on another PC." />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button Command="{Binding CancelInstallCommand}" Content="Stop" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" ToolTip="Stop after the current install; the rest aren't installed." />
                    <ui:Button Margin="8,0,0,0" Command="{Binding InstallForEveryoneCommand}" Content="Install for everyone" Icon="{ui:SymbolIcon Shield24}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}" ToolTip="For every account on this PC. Needs admin approval once." />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding InstallForMeCommand}" Content="Install for me" Icon="{ui:SymbolIcon ArrowDownload24}" IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}" ToolTip="Just for your account; no admin approval needed" />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
