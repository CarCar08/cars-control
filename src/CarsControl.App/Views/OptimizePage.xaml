<Page
    x:Class="CarsControl.App.Views.OptimizePage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:CarsControl.App.ViewModels"
    Title="Optimization"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  One switch from the catalog: title, evidence label, admin tag, Recommended badge, description, when it takes effect.  -->
        <DataTemplate x:Key="SwitchRow">
            <Grid Margin="0,8" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Margin="0,0,10,0" FontWeight="SemiBold" Text="{Binding Title}" />
                        <Border Style="{StaticResource Tag}" ToolTip="{Binding EvidenceTip}">
                            <TextBlock FontSize="11" Text="{Binding EvidenceText}" />
                        </Border>
                        <Border Style="{StaticResource Tag}" ToolTip="Changes it for every account on this PC, through the admin helper (one approval)." Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,3,0" FontSize="11" Symbol="Shield24" />
                                <TextBlock FontSize="11" Text="admin" />
                            </StackPanel>
                        </Border>
                        <ctl:RecommendedBadge Recommendation="{Binding Recommendation}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Subtle}" Text="{Binding Description}" TextWrapping="Wrap" />
                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Tweak.EvidenceNote}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:HyperlinkButton Margin="0,0,16,0" Padding="0,2" Command="{Binding OpenSourceCommand}" Content="Source" FontSize="12" ToolTip="{Binding Tweak.SourceUrl}" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />
                        <ui:HyperlinkButton Padding="0,2" Command="{Binding TestCommand}" Content="Test it on this PC" FontSize="12" ToolTip="Records a minute of a game, makes this change, records another minute, and tells you whether it measurably helped, with Keep and Undo." Visibility="{Binding CanTest, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding TakesEffect}" TextWrapping="Wrap" Visibility="{Binding TakesEffect, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Caution}" TextWrapping="Wrap" Visibility="{Binding HasCaution, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Status}" TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Subtle}" Text="{Binding AsShippedText}" Visibility="{Binding AsShippedText, Converter={StaticResource NullToCollapsed}}" />
                    <ui:ToggleSwitch AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanSwitch}" ToolTip="{Binding SwitchTip}" ToolTipService.ShowOnDisabled="True" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Optimization" />
                        <ctl:HelpButton VerticalAlignment="Center" Topic="optimize-evidence" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" Text="Windows settings that change how fast or smooth this PC feels, each labelled with how sure we are it helps. Every switch can be switched back. Nothing here weakens security." TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                    <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="Re-check" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Read every setting again (something else may have changed them)" />
                    <ui:Button Appearance="Primary" Command="{Binding ApplyRecommendedCommand}" Content="Apply recommended…" Icon="{ui:SymbolIcon Sparkle24}" ToolTip="Shows the recommended changes for your kind of PC (Settings › This PC) and applies them after you confirm. At most one admin prompt." />
                </StackPanel>
            </Grid>

            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,0,0,12" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />

            <ui:Card Margin="0,0,0,12" Padding="16,10" Visibility="{Binding PendingTestText, Converter={StaticResource NullToCollapsed}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PendingTestText}" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0" Command="{Binding ForgetTestCommand}" Content="Forget it" ToolTip="Drops the saved first minute. The change itself stays as it is; switch it back on its row if you like." />
                        <ui:Button Appearance="Primary" Command="{Binding ContinueTestCommand}" Content="Continue the test" ToolTip="Record the second minute and compare." />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!--  Power  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Power" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="How hard the processor may work, and what happens when you shut down." TextWrapping="Wrap" />
            <ui:Card Margin="0,0,0,16" Padding="16,6">
                <StackPanel>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Power mode" />
                                <ctl:HelpButton VerticalAlignment="Center" Topic="optimize-power-mode" />
                                <Border Style="{StaticResource Tag}" VerticalAlignment="Center" ToolTip="Windows' own setting; Microsoft documents what each mode does.">
                                    <TextBlock FontSize="11" Text="Documented" />
                                </Border>
                                <ctl:RecommendedBadge VerticalAlignment="Center" Recommendation="{Binding PowerModeRecommendation}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Subtle}" Text="{x:Static vm:OptimizeViewModel.PowerModeTip}" TextWrapping="Wrap" />
                            <StackPanel Visibility="{Binding PowerModeAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding PowerPlanText}" TextWrapping="Wrap" />
                                <ui:Button Margin="0,6,0,0" Command="{Binding UseBalancedPlanCommand}" Content="Use the Balanced plan" ToolTip="Makes Windows' Balanced plan active (no admin needed). The plan you use now is remembered, so you can switch back here." />
                            </StackPanel>
                            <ui:HyperlinkButton Padding="0,4" Command="{Binding RestorePlanCommand}" Content="{Binding RestorePlanText}" FontSize="12" ToolTip="Makes the plan you used before switching to Balanced active again." Visibility="{Binding RestorePlanText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="220" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Power mode" Visibility="{Binding PowerModeAvailable, Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding PowerModes}" SelectedItem="{Binding SelectedPowerMode}" ToolTip="Same as Settings › System › Power › Power mode" />
                    </Grid>
                    <Separator />
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Margin="0,0,10,0" FontWeight="SemiBold" Text="Hibernation" />
                                <Border Style="{StaticResource Tag}" ToolTip="Turning hibernation off deletes its file, which Windows reserves at a size based on your memory.">
                                    <TextBlock FontSize="11" Text="Documented" />
                                </Border>
                                <Border Style="{StaticResource Tag}" ToolTip="Changes it for the whole PC, through the admin helper (one approval).">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,3,0" FontSize="11" Symbol="Shield24" />
                                        <TextBlock FontSize="11" Text="admin" />
                                    </StackPanel>
                                </Border>
                                <ctl:RecommendedBadge Recommendation="{Binding HibernationRecommendation}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Subtle}" Text="Lets the PC save everything to disk and power off completely. Laptops use it when the battery runs low; desktops rarely do." TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding HibernationText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding HibernationBusy, Converter={StaticResource BoolToVisibility}}" />
                            <ui:ToggleSwitch AutomationProperties.Name="Hibernation" IsChecked="{Binding HibernationOn}" IsEnabled="{Binding HibernationBusy, Converter={StaticResource InverseBool}}" ToolTip="On: hibernation available (its file stays reserved). Off: frees the file; fast startup goes off too." />
                        </StackPanel>
                    </Grid>
                    <Separator />
                    <ItemsControl ItemTemplate="{StaticResource SwitchRow}" ItemsSource="{Binding PowerRows}" />
                </StackPanel>
            </ui:Card>

            <!--  Gaming  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Gaming" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="Windows' own gaming features, set the way that suits how you play." TextWrapping="Wrap" />
            <ui:Card Margin="0,0,0,16" Padding="16,6">
                <ItemsControl ItemTemplate="{StaticResource SwitchRow}" ItemsSource="{Binding GamingRows}" />
            </ui:Card>

            <!--  Visual effects  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Visual effects" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="Animations and see-through effects. On a modern PC these are a matter of taste." TextWrapping="Wrap" />
            <ui:Card Margin="0,0,0,16" Padding="16,6">
                <StackPanel>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Margin="0,0,10,0" FontWeight="SemiBold" Text="Window and menu animations" />
                                <Border Style="{StaticResource Tag}" ToolTip="Doesn't change speed on a modern PC; windows just open and close without the fade.">
                                    <TextBlock FontSize="11" Text="Your preference" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Subtle}" Text="Windows fades and slides windows and menus as they open and close. Off makes them appear instantly." TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Window and menu animations" IsChecked="{Binding AnimationsOn}" ToolTip="Same as Settings › Accessibility › Visual effects › Animation effects. Takes effect right away." />
                    </Grid>
                    <Separator />
                    <ItemsControl ItemTemplate="{StaticResource SwitchRow}" ItemsSource="{Binding VisualRows}" />
                </StackPanel>
            </ui:Card>

            <!--  Background and start-up  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Background and start-up" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="What happens right after you sign in. Choose which apps start with Windows on Apps › Startup." TextWrapping="Wrap" />
            <ui:Card Margin="0,0,0,16" Padding="16,6">
                <ItemsControl ItemTemplate="{StaticResource SwitchRow}" ItemsSource="{Binding BackgroundRows}" />
            </ui:Card>

            <!--  Network  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Network" />
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="How Windows uses your internet connection for its own downloads." TextWrapping="Wrap" />
            <ui:Card Margin="0,0,0,16" Padding="16,6">
                <ItemsControl ItemTemplate="{StaticResource SwitchRow}" ItemsSource="{Binding NetworkRows}" />
            </ui:Card>

            <!--  What's deliberately missing  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Not here, on purpose" />
            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Text="Network &quot;optimizers&quot; (Nagle, TCP tweaks), RAM cleaners and disabling Windows services wholesale: tests show they do nothing or cause problems. Memory integrity, Defender, SmartScreen, the firewall, UAC and Windows Update security: they protect this PC, and C.A.R.S. doesn't turn them off. Ultimate Performance plan: no measured gain over Best performance." />
        </StackPanel>
    </ScrollViewer>
</Page>
