<UserControl
    x:Class="CarsControl.App.Views.StorageTabs.MoveFoldersTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,12,12,24">
            <StackPanel Orientation="Horizontal"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Move a folder to another drive" /><ctl:HelpButton Topic="storage-move-folders" /></StackPanel>
            <TextBlock Margin="0,0,0,10" Style="{StaticResource Subtle}" Text="For a big folder that's filling a small drive: it's copied to another drive, checked, and replaced by a link, so every program that uses the old path keeps working. To move a Steam game, use the Games tab. Windows, Program Files, your profile's AppData and anything in a cloud folder are refused." TextTrimming="None" TextWrapping="Wrap" />
            <ui:Button Command="{Binding PickCommand}" Content="Choose a folder to move…" Icon="{ui:SymbolIcon FolderArrowRight24}" IsEnabled="{Binding Running, Converter={StaticResource InverseBool}}" ToolTip="Choose a big folder and the drive to move it to. It's copied, checked, then replaced by a link so programs still find it." />
            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,10,0,0" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel Margin="0,10,0,0" Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource Subtle}" Text="{Binding Stage}" />
            </StackPanel>

            <TextBlock Margin="0,22,0,6" Style="{StaticResource SectionTitle}" Text="Folders moved so far" />
            <TextBlock Margin="0,0,0,6" Style="{StaticResource Subtle}" Text="Nothing moved yet." Visibility="{Binding Moved.Count, Converter={StaticResource ZeroToVisible}}" />
            <ItemsControl ItemsSource="{Binding Moved}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,6" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Original}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding NewLocation, StringFormat='now at {0}'}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Detail}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Padding="6,3" Appearance="Transparent" AutomationProperties.Name="{Binding Original, StringFormat='Show where {0} lives now'}" Command="{Binding ShowCommand}" Icon="{ui:SymbolIcon Folder24}" ToolTip="Show where it lives now" />
                                    <ui:Button Command="{Binding MoveBackCommand}" Content="Move back" Icon="{ui:SymbolIcon ArrowUndo24}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" ToolTip="Move this folder back to where it was and remove the link." />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
