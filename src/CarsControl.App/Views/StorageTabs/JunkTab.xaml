<UserControl
    x:Class="CarsControl.App.Views.StorageTabs.JunkTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Margin="0,0,0,8" Style="{StaticResource Subtle}" Text="Things that are almost never wanted and that Cleanup doesn't cover. Everything found is listed first; what you tick goes to the Recycle Bin, so it can be put back." TextTrimming="None" TextWrapping="Wrap" />
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                <ui:Button Appearance="Primary" Command="{Binding FindCommand}" Content="Look for junk" Icon="{ui:SymbolIcon Search24}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" ToolTip="Look for old installers, empty folders, huge logs and game setup leftovers. Nothing is changed yet." />
                <ui:Button Margin="8,0,0,0" Command="{Binding CancelFindCommand}" Content="Stop" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" ToolTip="Stop looking." />
                <ui:ProgressRing Width="16" Height="16" Margin="12,0,0,0" IsIndeterminate="True" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Status}" />
            </StackPanel>
            <ui:InfoBar ctl:Notice.AutoDismiss="True" Margin="0,0,0,6" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
            <ItemsControl Margin="0,0,12,0" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,10" Padding="14,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox MinWidth="0" Margin="0,0,6,0" AutomationProperties.Name="{Binding Category, StringFormat='Tick everything in {0}'}" IsChecked="{Binding GroupSelected}" ToolTip="Tick or untick all of them" />
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Category}" />
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding Detail}" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,6" FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Help}" TextTrimming="None" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox MinWidth="0" AutomationProperties.Name="{Binding Path, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected}" ToolTip="Tick to recycle." />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding Modified}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SizeText}" />
                                                <ui:Button Grid.Column="4" Margin="8,0,0,0" Padding="6,2" Appearance="Transparent" AutomationProperties.Name="{Binding Path, StringFormat='Show {0}'}" Command="{Binding ShowCommand}" Icon="{ui:SymbolIcon Folder24}" ToolTip="Show in its folder" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="30,4,0,0" FontSize="12" Style="{StaticResource Subtle}" Text="{Binding HiddenText}" Visibility="{Binding HiddenText, Converter={StaticResource EmptyToCollapsed}}" />
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ui:Card Grid.Row="2" Margin="0,10,0,0" Padding="16,10" Visibility="{Binding Groups.Count, Converter={StaticResource ZeroToCollapsed}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Summary}" />
                    <ui:Button Margin="16,0,0,0" Command="{Binding SelectNoneCommand}" Content="Untick all" ToolTip="Untick everything." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Danger" Command="{Binding RecycleCommand}" Content="Recycle ticked" Icon="{ui:SymbolIcon Delete24}" IsEnabled="{Binding HasSelection}" ToolTip="Send what's ticked to the Recycle Bin, so it can be put back." />
                </StackPanel>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
