<Page
    x:Class="CarsControl.App.Views.RefreshPage"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:conv="clr-namespace:CarsControl.App.Converters"
    xmlns:tabs="clr-namespace:CarsControl.App.Views.HealthTabs"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Refresh"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <conv:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <!--  One update row, used by every source group and the "Always checked" section  -->
        <DataTemplate x:Key="UpdateItemTemplate">
            <ui:Card Margin="0,0,0,4" Padding="12,8">
                <ui:Card.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding Data.SkipVersionCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}"
                            Header="Skip this version"
                            IsEnabled="{Binding CanIgnore}" />
                        <MenuItem
                            Command="{Binding Data.IgnorePermanentlyCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}"
                            Header="Ignore updates permanently"
                            IsEnabled="{Binding CanIgnore}" />
                    </ContextMenu>
                </ui:Card.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox
                        MinWidth="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Title, StringFormat='Select {0}'}"
                        IsChecked="{Binding IsSelected}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" ToolTip="Include this update in the next selected-update run." />
                    <Grid Grid.Column="1" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon FontSize="20" Opacity="0.7" Symbol="{Binding SourceSymbol}" Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock MaxWidth="640" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title, Converter={StaticResource EmptyToNull}}" />
                            <TextBlock Margin="12,0,0,0" Style="{StaticResource Subtle}" Text="{Binding VersionText}" />
                            <Border Style="{StaticResource Badge}" ToolTip="Runs through the admin helper" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,4,0" FontSize="11" Symbol="Shield24" />
                                    <TextBlock FontSize="11" Text="Admin" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Style="{StaticResource Subtle}" Text="{Binding Note}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Style="{StaticResource Subtle}" Text="{Binding LastLine}" Visibility="{Binding LastLine, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock x:Name="Status" Margin="0,2,0,0" FontSize="12" Text="{Binding StatusText}" TextWrapping="Wrap" Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Warning}" TextWrapping="Wrap" Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                            Margin="0,0,10,0"
                            Padding="8,2"
                            Command="{Binding Data.SkipVersionCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}"
                            Content="Skip this version"
                            FontSize="12"
                            ToolTip="Hides this version until a newer one comes out. Nothing is installed or changed."
                            Visibility="{Binding OfferSkip, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button
                            Margin="0,0,10,0"
                            Padding="8,2"
                            Appearance="Transparent"
                            Command="{Binding Data.ShowChangesCommand, Source={StaticResource Proxy}}"
                            CommandParameter="{Binding}"
                            Content="What's new"
                            FontSize="12"
                            ToolTip="Opens the release notes (or the homepage) in your browser"
                            Visibility="{Binding CanShowChanges, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="CheckmarkCircle24" Visibility="{Binding IsSucceeded, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ErrorCircle24" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Style="{StaticResource PageTitle}" Text="Refresh" />
            <TextBlock Style="{StaticResource Subtle}" Text="Keep your apps, Windows and your tools up to date, and decide what Windows Update may do" TextWrapping="Wrap" />
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="Updates">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Summary}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Border
                    Margin="0,0,12,0"
                    Padding="10,4"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="12"
                    ToolTip="The admin helper is running. It closes when you exit, or after it has been idle."
                    Visibility="{Binding AdminSessionActive, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="ShieldCheckmark24" />
                        <TextBlock FontSize="12" Text="Admin session active" />
                    </StackPanel>
                </Border>
                <ui:ToggleSwitch Margin="0,0,16,0" Content="Dry run" IsChecked="{Binding DryRun}" ToolTip="Show exactly what would run, without changing anything" />
                <ui:ProgressRing Width="18" Height="18" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Command="{Binding CheckCommand}" Content="Check now" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="Ask every source (winget, Windows Update, WSL, PowerShell, npm, pip) what's out of date." />
            </StackPanel>
        </Grid>

        <!--  Banners  -->
        <StackPanel Grid.Row="1">
            <ui:InfoBar
                Title="Coming from UniGetUI"
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="True"
                Message="{Binding ImportOffer}"
                Severity="Informational"
                Visibility="{Binding ImportOffer, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel Margin="0,-4,0,12" Orientation="Horizontal" Visibility="{Binding ImportOffer, Converter={StaticResource NullToCollapsed}}">
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding ImportUniGetUiCommand}" Content="Import" ToolTip="Bring over UniGetUI's ignored updates and its update history, once." />
                <ui:Button Command="{Binding DismissImportCommand}" Content="No thanks" ToolTip="Don't offer the import again." />
            </StackPanel>
            <Grid Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}">
                <ui:InfoBar Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}" ctl:Notice.AutoDismiss="True" Margin="0,0,0,12" IsClosable="True" IsOpen="{Binding Banner, Converter={StaticResource OpenWhileSet}, Mode=TwoWay}" Message="{Binding Banner}" Severity="{Binding BannerKind, Converter={StaticResource NoticeSeverity}}" />
                <ui:Button
                    Margin="0,0,12,12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding OpenHistoryCommand}"
                    Content="Open History"
                    Icon="{ui:SymbolIcon History24}"
                    Visibility="{Binding BannerLinksHistory, Converter={StaticResource BoolToVisibility}}" ToolTip="Review detailed outcomes and output from completed operations." />
            </Grid>
        </StackPanel>

        <!--  Progress  -->
        <ui:Card Grid.Row="2" Margin="0,0,0,12" Padding="16,12" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ProgressText}" />
                    <ProgressBar Height="4" Margin="0,8,0,0" Value="{Binding Progress, Mode=OneWay}" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="16,0,0,0" Command="{Binding CancelCommand}" Content="Stop after this one" ToolTip="Finish the update that's running and skip the rest." />
            </Grid>
        </ui:Card>

        <!--  Results  -->
        <ScrollViewer Grid.Row="3" FocusVisualStyle="{x:Null}" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">
                <ui:Card Margin="0,0,0,16" Padding="16,14" Visibility="{Binding NothingFound, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,12,0" FontSize="24" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="CheckmarkCircle24" />
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Everything is up to date" />
                            <TextBlock Style="{StaticResource Subtle}" Text="The Store and Microsoft 365 below can still be asked to check on their own." />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock x:Name="GroupStatus" Style="{StaticResource Subtle}" Text="{Binding Status}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemTemplate="{StaticResource UpdateItemTemplate}" ItemsSource="{Binding Items}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter TargetName="GroupStatus" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,4,0,2" FontSize="16" FontWeight="SemiBold" Text="Always checked" />
                <TextBlock Margin="0,0,0,6" Style="{StaticResource Subtle}" Text="These can't list their updates ahead of time, so they're asked to check and install on their own. They aren't counted as updates found." TextWrapping="Wrap" />
                <ItemsControl ItemTemplate="{StaticResource UpdateItemTemplate}" ItemsSource="{Binding CheckActions}" />

                <Expander Margin="0,12,0,0" Header="{Binding OptionalHeader}" Visibility="{Binding Optional.Count, Converter={StaticResource ZeroToCollapsed}}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="Windows lists these under Optional updates and never installs them on its own. Most are old or generic drivers offered in case a device needs one, and they can replace your PC maker's own driver. Leave them unless a device isn't working. They aren't ticked and aren't counted as updates found." />
                        <ItemsControl ItemTemplate="{StaticResource UpdateItemTemplate}" ItemsSource="{Binding Optional}" />
                    </StackPanel>
                </Expander>

                <Expander Margin="0,12,0,0" Header="{Binding IgnoredHeader}">
                    <StackPanel>
                    <TextBlock Style="{StaticResource Subtle}" Text="Nothing is ignored. To hide an update, right-click it › Skip this version or Ignore updates permanently." TextWrapping="Wrap" Visibility="{Binding Ignored.Count, Converter={StaticResource ZeroToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Ignored}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Margin="12,0,0,0" Style="{StaticResource Subtle}" Text="{Binding Rule}" />
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" Command="{Binding Data.StopIgnoringCommand, Source={StaticResource Proxy}}" CommandParameter="{Binding}" Content="Stop ignoring" ToolTip="Offer this app's updates again." />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!--  Action bar (pinned now that the page fits the window)  -->
        <ui:Card Grid.Row="4" Margin="0,12,0,0" Padding="16,10">
            <Grid>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding SelectionText}" />
                    <ui:Button Margin="16,0,4,0" Command="{Binding SelectAllCommand}" Content="All" ToolTip="Tick every update." />
                    <ui:Button Command="{Binding SelectNoneCommand}" Content="None" ToolTip="Untick every update." />
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" Appearance="Primary" Command="{Binding UpdateSelectedCommand}" Content="Update selected" Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Install the ticked updates. Admin ones share one approval; per-user ones need none." />
            </Grid>
        </ui:Card>
    </Grid>
            </TabItem>
            <TabItem Header="Windows Update">
                <tabs:WindowsUpdateTab />
            </TabItem>
        </TabControl>
    </Grid>
</Page>
