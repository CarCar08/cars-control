<ui:FluentWindow
    x:Class="CarsControl.App.Views.MoveWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Move"
    Width="640"
    Height="460"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="C.A.R.S. Control" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,4,24,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" TextWrapping="Wrap" />

            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="Move it to" />
            <ComboBox Margin="0,4,0,10" HorizontalAlignment="Stretch" AutomationProperties.Name="Where to move it" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" ToolTip="Choose the destination library or drive; review the move plan before starting." />

            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding PlanText}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Blocker}" TextWrapping="Wrap" Visibility="{Binding Blocker, Converter={StaticResource NullToCollapsed}}" />

            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="6" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Stage}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="Result" Margin="0,14,0,0" FontWeight="SemiBold" Text="{Binding ResultText}" TextWrapping="Wrap" Visibility="{Binding ResultText, Converter={StaticResource NullToCollapsed}}">
                <TextBlock.Style>
                    <!--  Red is the style's default, not a local value: a local Foreground would beat the success trigger (successes showed in red).  -->
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultOk}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="24,0,24,20" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Command="{Binding StopCommand}" Content="Stop" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" ToolTip="Cancel this operation; the result explains where the original and any partial copy remain." />
            <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding StartCommand}" Content="Move it" Icon="{ui:SymbolIcon ArrowRight24}" Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}" ToolTip="Start the reviewed copy and verification plan; original files are removed only after verification." />
            <ui:Button Command="{Binding CloseCommand}" Content="{Binding CloseText}" IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" ToolTip="Close this move window; the result above records the actual file locations." />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
