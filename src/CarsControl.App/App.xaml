<Application
    x:Class="CarsControl.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:CarsControl.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Text given as a checkbox's or radio button's Content wraps instead of being cut off when the window is narrow
                  ("System Pro…"). Content that's already an element (a StackPanel, a TextBlock) is shown as is: a selector, not
                  ContentTemplate, because WPF applies a ContentTemplate to element content too and shows its type name. These live
                  here, not in Styles.xaml, so BasedOn can find WPF-UI's own styles.  -->
            <DataTemplate x:Key="WrappingText">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DataTemplate>
            <ctl:WrapTextSelector x:Key="WrapTextSelector" Text="{StaticResource WrappingText}" />
            <Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox">
                <Setter Property="ContentTemplateSelector" Value="{StaticResource WrapTextSelector}" />
            </Style>
            <Style BasedOn="{StaticResource DefaultRadioButtonStyle}" TargetType="RadioButton">
                <Setter Property="ContentTemplateSelector" Value="{StaticResource WrapTextSelector}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
