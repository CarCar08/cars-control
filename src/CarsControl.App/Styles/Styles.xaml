<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:CarsControl.App.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
    <conv:EmptyToVisibilityConverter x:Key="EmptyToCollapsed" />
    <conv:TabIndexConverter x:Key="TabIndex" />
    <conv:NullToVisibilityConverter x:Key="NotNullToCollapsed" Invert="True" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:BytesTextConverter x:Key="BytesText" />
    <conv:ZeroToVisibleConverter x:Key="ZeroToVisible" />
    <conv:ZeroToVisibleConverter x:Key="ZeroToCollapsed" Invert="True" />
    <conv:EmptyToNullConverter x:Key="EmptyToNull" />
    <conv:SortSymbolConverter x:Key="SortSymbol" />
    <conv:NoticeSeverityConverter x:Key="NoticeSeverity" />
    <conv:OpenWhileSetConverter x:Key="OpenWhileSet" />
    <conv:HexBrushConverter x:Key="HexBrush" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Subtle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>

    <!--  Lists of cards and rows are containers, not Tab stops: the controls inside them are.  -->
    <Style TargetType="ItemsControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!--  filter chips: toggle buttons that wrap; selected = accent  -->
    <Style x:Key="ChipToggle" BasedOn="{StaticResource {x:Type ToggleButton}}" TargetType="ToggleButton">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <DataTemplate x:Key="ChipTemplate">
        <ToggleButton
            x:Name="T"
            AutomationProperties.Name="{Binding}"
            IsChecked="{Binding IsSelected}"
            Style="{StaticResource ChipToggle}"
            ToolTip="{Binding ToolTip, Converter={StaticResource EmptyToNull}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Margin="6,0,0,0" Opacity="0.7" Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </ToggleButton>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                <Setter TargetName="T" Property="Opacity" Value="0.5" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="WrapItems">
        <WrapPanel />
    </ItemsPanelTemplate>

    <!--  A card with a colored edge for a finding / status: Level is "Bad", "Watch", "Good" or "Info"  -->
    <Style x:Key="LevelCard" TargetType="Border">
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Bad">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Watch">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Good">
                <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Text colored by Level, for one-line verdicts  -->
    <Style x:Key="LevelText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="Bad">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Watch">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="Good">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
