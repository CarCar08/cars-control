<ui:FluentWindow
    x:Class="CarsControl.SetupApp.WizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="C.A.R.S. Control Setup"
    Width="640"
    Height="540"
    ExtendsContentIntoTitleBar="True"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Icon="pack://application:,,,/Assets/cars.png"
    ResizeMode="CanMinimize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="Subtle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="C.A.R.S. Control Setup" Grid.Row="0" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/cars.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="40,12,40,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header: logo, headline, subline  -->
            <StackPanel Orientation="Horizontal">
                <Image Width="56" Height="56" Margin="0,0,18,0" Source="pack://application:,,,/Assets/cars.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Left" FontSize="26" FontWeight="SemiBold" Text="{Binding Headline}" TextWrapping="Wrap" MaxWidth="470" />
                    <TextBlock HorizontalAlignment="Left" MaxWidth="470" Style="{StaticResource Subtle}" Text="{Binding Subline}" ToolTip="{Binding Subline}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="14" Visibility="{Binding HasSubline, Converter={StaticResource B2V}}" />
                </StackPanel>
            </StackPanel>

            <!--  Welcome: what will happen and the two choices  -->
            <StackPanel Grid.Row="1" Margin="0,24,0,0" Visibility="{Binding IsWelcome, Converter={StaticResource B2V}}">
                <TextBlock FontSize="14" Text="{Binding Body}" TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Subtle}" Text="{Binding Fine}" />
                <StackPanel Margin="0,22,0,0">
                    <CheckBox Content="{Binding StartOptionText}" IsChecked="{Binding StartWithWindows}" Visibility="{Binding ShowStartOption, Converter={StaticResource B2V}}" />
                    <CheckBox Margin="0,8,0,0" Content="Open C.A.R.S. Control when Setup is finished" IsChecked="{Binding LaunchWhenDone}" Visibility="{Binding ShowLaunchOption, Converter={StaticResource B2V}}" />
                </StackPanel>
            </StackPanel>

            <!--  Uninstall: what stays  -->
            <StackPanel Grid.Row="1" Margin="0,24,0,0" Visibility="{Binding IsConfirm, Converter={StaticResource B2V}}">
                <TextBlock FontSize="14" Text="{Binding Body}" TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Subtle}" Text="{Binding Fine}" />
                <StackPanel Margin="0,22,0,0">
                    <CheckBox Content="Also delete my settings, history and scans" IsChecked="{Binding RemoveUserData}" />
                    <CheckBox Margin="0,8,0,0" Content="Also delete the admin helper's logs and quarantined leftovers (ProgramData)" IsChecked="{Binding RemoveMachineData}" />
                </StackPanel>
            </StackPanel>

            <!--  Working: progress and the log  -->
            <StackPanel Grid.Row="1" Margin="0,40,0,0" Visibility="{Binding IsWorking, Converter={StaticResource B2V}}">
                <TextBlock FontSize="15" Text="{Binding Step}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Height="8" Margin="0,12,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Subtle}" Text="Windows may ask for an administrator's approval now. Please don't close this window." />
                <Expander Margin="0,24,0,0" Header="Details">
                    <TextBox Height="140" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="11" IsReadOnly="True" Text="{Binding LogText, Mode=OneWay}" VerticalScrollBarVisibility="Auto" TextChanged="OnLogChanged" />
                </Expander>
            </StackPanel>

            <!--  Done  -->
            <StackPanel Grid.Row="1" Margin="0,28,0,0" Visibility="{Binding IsDone, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,12,0" FontSize="28">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultOk}" Value="False">
                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding ResultTitle}" TextWrapping="Wrap" MaxWidth="480" />
                </StackPanel>
                <TextBlock Margin="0,14,0,0" FontSize="14" Text="{Binding ResultText}" TextWrapping="Wrap" />
                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Command="{Binding ShowLogCommand}" Content="Open the log" />
                    <ui:Button Command="{Binding CopyDetailsCommand}" Content="Copy details" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Subtle}" Text="{Binding CopyHint}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  Footer buttons  -->
        <Border Grid.Row="2" Padding="40,14" Background="{DynamicResource ControlFillColorSecondaryBrush}" Visibility="{Binding ShowFooterButtons, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button HorizontalAlignment="Left" Command="{Binding Secondary}" Content="{Binding SecondaryText}" Visibility="{Binding HasSecondaryOnWelcome, Converter={StaticResource B2V}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding Primary}" Content="{Binding PrimaryText}" IsEnabled="{Binding PrimaryEnabled}" MinWidth="110" Visibility="{Binding ShowPrimary, Converter={StaticResource B2V}}" />
                    <ui:Button Margin="0,0,8,0" Appearance="Primary" Command="{Binding LaunchCommand}" Content="Open C.A.R.S. Control" Visibility="{Binding ShowLaunchButton, Converter={StaticResource B2V}}" />
                    <ui:Button Command="{Binding CloseCommand}" Content="{Binding CloseText}" MinWidth="90" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
